<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Crimson+Text:ital,wght@0,400;0,600;1,400&family=Mulish:wght@400;600;700&family=Open+Sans:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    >

    {% # Load the critical + ANIA design-system CSS (compiled from the Astro src, pixel-identical) %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ania.css' | asset_url | stylesheet_tag }}

    {% comment %} {% # ANIA Component Library — dimuat SEKALI untuk halaman index (landing page).
       Semua section homepage (main-hero, main-most-popular, main-occasions,
       main-why-ania, main-testimonials, main-faq, main-custom-order) dibangun dari
       snippet lib-*.liquid dan butuh CSS ini. Halaman lain yang memakai library
       (mis. /pages/components) meng-import sendiri via section-nya. %} {% endcomment %}
    {% if request.page_type == 'index' %}
      {{ 'lib-components.css' | asset_url | stylesheet_tag }}
    {% endif %}

    {% # Social, title, etc. (includes charset + viewport) %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="m-0 bg-[#FAFAF2] text-[#525252] template-{{ template.name | handle }}">
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {% comment %} {% # JS Component Library — di-load di sini (sekali) untuk halaman index, BUKAN
       per-section: lib-components.js meng-init tiap data-component pada
       DOMContentLoaded, jadi load berulang = event listener ganda. %} {% endcomment %}
    {% if request.page_type == 'index' %}
      <script src="{{ 'lib-components.js' | asset_url }}" defer></script>
    {% endif %}
  </body>
</html>
