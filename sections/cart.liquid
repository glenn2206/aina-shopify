{% comment %}
  Cart — "Cart Totals & Delivery Details" (Figma).
  Rebuild pixel-by-pixel: cart items w/ qty stepper + remove, delivery/sender
  details, cart totals + checkout.

  Functionality:
    - Qty +/- and remove run live against the real Cart AJAX API
      (/cart/change.js) and refresh via Shopify's Section Rendering API, so
      totals, line prices and the header cart badge always reflect real data.
    - The qty input is a real `updates[]` field and the checkout button is a
      real form submit, so everything still works if JavaScript fails to load.
    - Sender fields persist as real cart attributes (/cart/update.js), and
      "Receive on" / "Send to" read from those same cart attributes.
{% endcomment %}
{%- liquid
  assign delivery_fee_cents = section.settings.delivery_fee | default: 0 | times: 100
  assign grand_total = cart.total_price | plus: delivery_fee_cents
  assign continue_url = routes.all_products_collection_url | default: routes.root_url
  assign empty_heading_fb = 'cart_page.empty_heading' | t
  assign empty_text_fb = 'cart_page.empty_text' | t
  assign empty_button_fb = 'cart_page.shop_flowers' | t
  assign continue_label_fb = 'cart_page.continue_shopping' | t
  assign checkout_label_fb = 'cart_page.checkout' | t
-%}

<section class="bg-[#FAFAF2]">
  <div class="mx-auto w-full max-w-[1440px] px-4 py-10 sm:px-6 lg:px-[70px] lg:py-14" data-cart-refresh>
    <h1 class="sr-only">{{ 'cart_page.title' | t }}</h1>

    {% if cart.item_count == 0 %}
      <div class="mx-auto flex max-w-md flex-col items-center gap-4 py-16 text-center">
        <h2 class="font-['Crimson_Text'] text-3xl text-[#3D3B2F]">{{ section.settings.empty_heading | default: empty_heading_fb }}</h2>
        <p class="text-sm leading-relaxed text-[#6D6D6D]">{{ section.settings.empty_text | default: empty_text_fb }}</p>
        <a
          href="{{ continue_url }}"
          class="mt-2 flex h-11 items-center justify-center rounded-lg bg-[#899B7A] px-8 text-xs font-semibold uppercase tracking-[1px] text-white transition-colors duration-200 hover:bg-[#7a8c6b]"
        >
          {{ section.settings.empty_button_label | default: empty_button_fb }}
        </a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" novalidate data-cart-form>
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_380px]">
          {% comment %} Left: items + delivery + sender details {% endcomment %}
          <div>
            <div>
              {% for item in cart.items %}
                <div class="flex items-center gap-4 py-5 {% unless forloop.last %}border-b border-[#EAE8E8]{% endunless %}" data-cart-item>
                  <a
                    href="{{ item.url_to_remove }}"
                    data-remove-item
                    data-key="{{ item.key }}"
                    aria-label="{{ 'cart_page.remove_html' | t: product: item.product.title | escape }}"
                    class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-[#CCC8A8] text-[#6D6D6D] transition-colors duration-150 hover:border-[#3D3B2F] hover:text-[#3D3B2F]"
                  >
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                      <path d="M1 1l8 8M9 1l-8 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                    </svg>
                  </a>

                  <a href="{{ item.url }}" class="block h-[72px] w-[72px] shrink-0 overflow-hidden rounded-lg bg-white">
                    {% if item.image %}
                      {{ item.image | image_url: width: 160 | image_tag: class: 'h-full w-full object-cover', alt: item.product.title | escape }}
                    {% endif %}
                  </a>

                  <div class="min-w-0 flex-1">
                    <a href="{{ item.url }}" class="block truncate text-sm font-semibold text-[#3D3B2F] hover:underline">{{ item.product.title }}</a>
                    {% unless item.variant.title == 'Default Title' %}
                      <p class="mt-0.5 truncate text-xs text-[#6D6D6D]">{{ item.variant.title }}</p>
                    {% endunless %}
                  </div>

                  <div class="flex h-9 shrink-0 items-center overflow-hidden rounded-lg border border-[#CCC8A8]" data-qty-wrapper data-key="{{ item.key }}">
                    <button type="button" data-qty-decrease aria-label="{{ 'cart_page.decrease_qty' | t }}" class="flex h-full w-8 items-center justify-center text-[#3D3B2F] transition-colors duration-150 hover:bg-[#FAFAF2]">−</button>
                    <input
                      type="number"
                      inputmode="numeric"
                      min="0"
                      name="updates[{{ item.key }}]"
                      value="{{ item.quantity }}"
                      data-qty-input
                      aria-label="{{ 'cart_page.quantity_html' | t: product: item.product.title | escape }}"
                      class="h-full w-10 border-x border-[#CCC8A8] bg-white text-center text-sm text-[#3D3B2F] outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                    >
                    <button type="button" data-qty-increase aria-label="{{ 'cart_page.increase_qty' | t }}" class="flex h-full w-8 items-center justify-center text-[#3D3B2F] transition-colors duration-150 hover:bg-[#FAFAF2]">+</button>
                  </div>

                  <p class="w-28 shrink-0 text-right text-sm font-semibold text-[#3D3B2F]" data-line-price>{{ item.final_line_price | money }}</p>
                </div>
              {% endfor %}
            </div>

            {% comment %} Receive on / Send to {% endcomment %}
            <div class="mt-6 flex items-center justify-between gap-6 rounded-lg border border-[#EAE8E8] bg-white p-5">
              <div class="flex flex-1 flex-wrap gap-x-10 gap-y-3">
                <div>
                  <p class="text-xs text-[#6D6D6D]">{{ 'cart_page.receive_on' | t }}</p>
                  <p class="mt-1 text-sm font-semibold text-[#3D3B2F]">{{ cart.attributes['Receive on'] | default: '—' }}</p>
                </div>
                <div>
                  <p class="text-xs text-[#6D6D6D]">{{ 'cart_page.send_to' | t }}</p>
                  <p class="mt-1 text-sm font-semibold text-[#3D3B2F]">{{ cart.attributes['Send to'] | default: '—' }}</p>
                </div>
              </div>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0 text-[#899B7A]">
                <path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </div>

            {% comment %} Sender fields — persisted as cart attributes {% endcomment %}
            <div class="mt-6 space-y-4">
              <div>
                <label for="cart-sender-name" class="text-xs text-[#6D6D6D]">{{ 'cart_page.sender_name' | t }}</label>
                <input
                  id="cart-sender-name"
                  type="text"
                  name="attributes[Sender Name]"
                  data-attr-field="Sender Name"
                  value="{{ cart.attributes['Sender Name'] }}"
                  placeholder="{{ 'cart_page.sender_name_placeholder' | t }}"
                  class="mt-1.5 w-full rounded-lg border border-[#CCC8A8] bg-white px-3.5 py-2.5 text-sm text-[#3D3B2F] outline-none transition-colors duration-150 placeholder:text-[#A2A2A2] focus:border-[#3D3B2F]"
                >
              </div>
              <div>
                <label for="cart-sender-wa" class="text-xs text-[#6D6D6D]">{{ 'cart_page.sender_wa' | t }}</label>
                <input
                  id="cart-sender-wa"
                  type="tel"
                  name="attributes[Sender WhatsApp]"
                  data-attr-field="Sender WhatsApp"
                  value="{{ cart.attributes['Sender WhatsApp'] }}"
                  placeholder="{{ 'cart_page.sender_wa_placeholder' | t }}"
                  class="mt-1.5 w-full rounded-lg border border-[#CCC8A8] bg-white px-3.5 py-2.5 text-sm text-[#3D3B2F] outline-none transition-colors duration-150 placeholder:text-[#A2A2A2] focus:border-[#3D3B2F]"
                >
              </div>
              <div>
                <label for="cart-sender-email" class="text-xs text-[#6D6D6D]">{{ 'cart_page.sender_email' | t }}</label>
                <input
                  id="cart-sender-email"
                  type="email"
                  name="attributes[Sender Email]"
                  data-attr-field="Sender Email"
                  value="{{ cart.attributes['Sender Email'] }}"
                  placeholder="{{ 'cart_page.sender_email_placeholder' | t }}"
                  class="mt-1.5 w-full rounded-lg border border-[#CCC8A8] bg-white px-3.5 py-2.5 text-sm text-[#3D3B2F] outline-none transition-colors duration-150 placeholder:text-[#A2A2A2] focus:border-[#3D3B2F]"
                >
              </div>
            </div>
          </div>

          {% comment %} Right: continue shopping + totals {% endcomment %}
          <div class="lg:border-l lg:border-[#CCC8A8] lg:pl-10">
            <a
              href="{{ continue_url }}"
              class="flex h-11 w-full items-center justify-center rounded-lg border border-[#CCC8A8] text-xs font-semibold uppercase tracking-[1px] text-[#3D3B2F] transition-colors duration-200 hover:border-[#3D3B2F]"
            >
              {{ section.settings.continue_shopping_label | default: continue_label_fb }}
            </a>

            <div class="mt-6 rounded-lg border border-[#CCC8A8] bg-white p-6">
              <h2 class="text-base font-semibold text-[#3D3B2F]">{{ 'cart_page.cart_totals' | t }}</h2>

              <p class="mt-3 hidden text-xs text-[#B3261E]" data-cart-error role="alert" data-i18n-error="{{ 'cart_page.update_error' | t }}"></p>

              <div class="mt-5 flex items-center justify-between text-sm text-[#3D3B2F]">
                <span>{{ 'cart_page.subtotal' | t }}</span>
                <span data-cart-subtotal>{{ cart.total_price | money }}</span>
              </div>
              <div class="mt-3 flex items-center justify-between text-sm text-[#3D3B2F]">
                <span>{{ 'cart_page.delivery' | t }}</span>
                <span>{{ delivery_fee_cents | money }}</span>
              </div>
              <div class="mt-4 flex items-center justify-between border-t border-[#EAE8E8] pt-4 text-sm font-semibold text-[#3D3B2F]">
                <span>{{ 'cart_page.total' | t }}</span>
                <span data-cart-total>{{ grand_total | money }}</span>
              </div>

              <button
                type="submit"
                name="checkout"
                class="mt-5 flex h-12 w-full items-center justify-center rounded-lg bg-[#BBCCBF] text-center text-xs font-semibold uppercase tracking-[1px] text-white outline-none transition-colors duration-200 hover:bg-[#A8BCAE] focus-visible:ring-2 focus-visible:ring-[#3D3B2F] focus-visible:ring-offset-2"
              >
                {{ section.settings.checkout_label | default: checkout_label_fb }} - {{ grand_total | money }}
              </button>
            </div>
          </div>
        </div>
      </form>
    {% endif %}
  </div>
</section>

<script>
  // Cart page — live quantity/remove via the Cart AJAX API, refreshed through
  // Shopify's Section Rendering API. Bound at the document level (delegation)
  // so it keeps working after the section content gets swapped out.
  (() => {
    const SECTION_ID = {{ section.id | json }};
    const REFRESH_URL = `${window.location.pathname}?section_id=${SECTION_ID}`;
    let busy = false;
    let saveTimer = null;

    const setBusy = (state) => {
      busy = state;
      document.querySelectorAll('[data-cart-refresh]').forEach((el) => {
        el.classList.toggle('pointer-events-none', state);
        el.style.opacity = state ? '0.6' : '';
      });
    };

    const syncCartBadge = (count) => {
      if (typeof count !== 'number') return;
      document.dispatchEvent(new CustomEvent('ania:cartcount', { detail: { count } }));
    };

    const refreshSection = async () => {
      const res = await fetch(REFRESH_URL);
      if (!res.ok) return;
      const html = await res.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const fresh = doc.querySelector('[data-cart-refresh]');
      const current = document.querySelector('[data-cart-refresh]');
      if (fresh && current) current.replaceWith(fresh);
    };

    const showError = (message) => {
      const slot = document.querySelector('[data-cart-error]');
      if (!slot) return;
      slot.textContent = message;
      slot.classList.remove('hidden');
      clearTimeout(showError.timer);
      showError.timer = setTimeout(() => slot.classList.add('hidden'), 5000);
    };

    const changeLine = async (key, quantity) => {
      if (busy || !key) return;
      setBusy(true);
      let errorMessage = null;
      try {
        const res = await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: key, quantity }),
        });
        const data = await res.json();
        if (res.ok) {
          syncCartBadge(data.item_count);
        } else {
          errorMessage = data.message || document.querySelector('[data-cart-error]')?.dataset.i18nError || 'This item could not be updated.';
        }
        await refreshSection();
        if (errorMessage) showError(errorMessage);
      } catch (err) {
        console.error('[ANIA cart] update failed', err);
      } finally {
        setBusy(false);
      }
    };

    const saveAttributes = (attributes) => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(async () => {
        try {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ attributes }),
          });
        } catch (err) {
          console.error('[ANIA cart] saving details failed', err);
        }
      }, 300);
    };

    document.addEventListener('click', (e) => {
      const decrease = e.target.closest('[data-qty-decrease]');
      const increase = e.target.closest('[data-qty-increase]');
      const remove = e.target.closest('[data-remove-item]');

      if (decrease || increase) {
        const wrapper = (decrease || increase).closest('[data-qty-wrapper]');
        const input = wrapper?.querySelector('[data-qty-input]');
        if (!input) return;
        const current = parseInt(input.value, 10) || 0;
        const next = Math.max(0, current + (increase ? 1 : -1));
        input.value = next;
        changeLine(wrapper.dataset.key, next);
        return;
      }

      if (remove) {
        e.preventDefault();
        changeLine(remove.dataset.key, 0);
      }
    });

    document.addEventListener('change', (e) => {
      const qtyInput = e.target.closest('[data-qty-input]');
      if (qtyInput) {
        const wrapper = qtyInput.closest('[data-qty-wrapper]');
        const next = Math.max(0, parseInt(qtyInput.value, 10) || 0);
        qtyInput.value = next;
        changeLine(wrapper?.dataset.key, next);
        return;
      }

      const attrField = e.target.closest('[data-attr-field]');
      if (attrField) {
        saveAttributes({ [attrField.dataset.attrField]: attrField.value });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "number",
      "id": "delivery_fee",
      "label": "Flat delivery fee (Rp)",
      "info": "Shown as an estimate on the cart page. Actual shipping is calculated at checkout.",
      "default": 50000
    },
    {
      "type": "text",
      "id": "continue_shopping_label",
      "label": "Continue shopping button label",
      "default": "Continue Shopping?"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "default": "Proceed to Checkout"
    },
    {
      "type": "header",
      "content": "Empty cart"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading",
      "default": "Your cart is empty"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text",
      "default": "Looks like you haven't added anything yet. Let's find your perfect bouquet."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Button label",
      "default": "Shop Flowers"
    }
  ]
}
{% endschema %}
