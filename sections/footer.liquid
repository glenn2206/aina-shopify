{% comment %}
  Footer — ANIA homepage footer (Figma node 137:1006).
  Rebuild of src astro/components/sections/HomeFooter.astro (pixel-by-pixel):
    - Order section: "Find your Perfect Bouquet today!" + email + 2 CTAs
    - Link columns Shop / Resources / Help
    - Logo + tagline "Let Flowers Speak for You" + social
    - Payment chips + copyright
{% endcomment %}
{%- liquid
  assign order_heading_fb = 'footer.order_heading' | t
  assign email_label_fb = 'footer.email_label' | t
-%}

<footer class="bg-[#FDF6F1]">
  {% comment %} Order section {% endcomment %}
  <div class="border-b border-t border-[#CCC8A8]">
    <div class="mx-auto flex w-full max-w-[1440px] flex-col gap-8 px-4 py-10 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10 lg:px-[70px] lg:py-[50px]">
      <h2 class="max-w-[501px] font-['Cormorant_Garamond'] text-4xl font-normal leading-tight text-[#3D3B2F] lg:text-[40px]">
        {{ section.settings.order_heading | default: order_heading_fb }}
      </h2>

      <form class="flex w-full max-w-[506px] flex-col gap-[5px]" onsubmit="return false">
        <label for="footer-email" class="text-xs font-normal text-[#525252]">{{ section.settings.email_label | default: email_label_fb }}</label>
        <div class="flex h-11 items-center gap-2 rounded-lg border border-[#CCC8A8] bg-white px-4">
          <input
            id="footer-email"
            type="email"
            placeholder="{{ 'footer.email_placeholder' | t }}"
            class="h-full flex-1 bg-transparent text-sm font-normal text-[#525252] outline-none placeholder:text-[#A2A2A2]"
          >
          <button
            type="submit"
            aria-label="{{ 'footer.subscribe' | t }}"
            class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-md border-0 bg-[#899B7A] p-0 text-white transition-colors duration-200 hover:bg-[#7a8c6b]"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 12h16m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </form>

      <div class="flex shrink-0 flex-wrap items-center gap-4">
        <a
          href="{{ section.settings.contact_link | default: routes.root_url }}#contact"
          class="flex h-9 items-center justify-center rounded-lg bg-[#899B7A] px-[18px] text-xs font-semibold uppercase tracking-[0.5px] text-white transition-colors duration-200 hover:bg-[#7a8c6b]"
        >
          {{ 'footer.consult_team' | t }}
        </a>
        <a
          href="{{ routes.all_products_collection_url }}"
          class="flex h-9 items-center justify-center rounded-lg border border-[#899B7A] px-[18px] text-xs font-semibold uppercase tracking-[0.5px] text-[#899B7A] transition-colors duration-200 hover:bg-[#899B7A]/10"
        >
          {{ 'footer.shop_flowers' | t }}
        </a>
      </div>
    </div>
  </div>

  {% comment %} Body footer {% endcomment %}
  <div class="border-b border-[#CCC8A8]">
    <div class="mx-auto flex w-full max-w-[1440px] flex-col gap-12 px-4 py-12 sm:px-6 lg:flex-row lg:justify-between lg:gap-10 lg:px-[70px] lg:py-[70px]">
      {% comment %} Logo + tagline + social {% endcomment %}
      <div class="flex max-w-[300px] flex-col gap-6">
        <div>
          <img src="{{ 'logo-aina.svg' | asset_url }}" alt="ANIA" width="142" height="104" class="h-24 w-auto object-contain" loading="lazy">
          <p class="mt-4 text-[11px] font-semibold uppercase tracking-[4.24px] text-[#3D3B2F]">{{ 'footer.tagline' | t }}</p>
        </div>

        <div class="flex flex-col gap-3">
          <a href="#" class="flex items-center gap-3 text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="1" y="1" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.3" />
              <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.3" />
              <circle cx="12" cy="4" r="1" fill="currentColor" />
            </svg>
            Instagram
          </a>
          <a href="#" class="flex items-center gap-3 text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="1" y="1" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.3" />
              <path
                d="M9.3 12V8.4h1.3l.2-1.6H9.3v-1c0-.5.1-.8.8-.8h.8V3.4c-.1 0-.6-.1-1.3-.1-1.3 0-2.2.8-2.2 2.3v1.2H6v1.6h1.4V12h1.9Z"
                fill="currentColor"
              />
            </svg>
            Facebook
          </a>
          <a href="#" class="flex items-center gap-3 text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="1" y="1" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.3" />
              <path
                d="M9.7 3.8c.3.9 1 1.6 2 1.8v1.6a3.6 3.6 0 0 1-2-.6v3.1a3 3 0 1 1-2.4-2.9v1.6a1.4 1.4 0 1 0 1 1.3V3.8h1.4Z"
                fill="currentColor"
              />
            </svg>
            TikTok
          </a>
        </div>
      </div>

      {% comment %} Kolom link {% endcomment %}
      <div class="flex flex-wrap gap-10 lg:gap-9">
        <div class="flex flex-col gap-4">
          <h3 class="font-['Crimson_Text'] text-xl font-semibold text-[#3D3B2F]">{{ 'footer.shop_heading' | t }}</h3>
          <ul class="flex flex-col gap-[10px]">
            {% if section.settings.menu_shop.links.size > 0 %}
              {% for link in section.settings.menu_shop.links %}
                <li>
                  <a href="{{ link.url }}" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ link.title }}</a>
                </li>
              {% endfor %}
            {% else %}
              <li><a href="{{ routes.all_products_collection_url }}" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ 'footer.shop_links.all_products' | t }}</a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ 'footer.shop_links.preserved' | t }}</a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ 'footer.shop_links.bloom_box' | t }}</a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ 'footer.shop_links.premium_wrapped' | t }}</a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ 'footer.shop_links.vase' | t }}</a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ 'footer.shop_links.standing' | t }}</a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ 'footer.shop_links.accessories' | t }}</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="flex flex-col gap-4">
          <h3 class="font-['Crimson_Text'] text-xl font-semibold text-[#3D3B2F]">{{ 'footer.resources_heading' | t }}</h3>
          <ul class="flex flex-col gap-[10px]">
            {% if section.settings.menu_resources.links.size > 0 %}
              {% for link in section.settings.menu_resources.links %}
                <li>
                  <a href="{{ link.url }}" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ link.title }}</a>
                </li>
              {% endfor %}
            {% else %}
              <li><a href="{{ pages.terms-and-condition.url | default: '/pages/terms-and-condition' }}" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ 'footer.resource_links.terms' | t }}</a></li>
              <li><a href="#" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ 'footer.resource_links.faq' | t }}</a></li>
              <li><a href="#" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">{{ 'footer.resource_links.how_to_order' | t }}</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="flex flex-col gap-4">
          <h3 class="font-['Crimson_Text'] text-xl font-semibold text-[#3D3B2F]">{{ 'footer.help_heading' | t }}</h3>
          <a href="mailto:team@myania.com" class="text-base font-normal text-[#3D3B2F] transition-opacity hover:opacity-70">team@myania.com</a>
        </div>
      </div>

      {% comment %} Payment {% endcomment %}
      <div class="flex max-w-[280px] flex-col gap-4">
        <h3 class="font-['Crimson_Text'] text-xl font-semibold text-[#3D3B2F]">{{ 'footer.we_accept' | t }}</h3>
        <div class="flex flex-wrap gap-2">
          <span class="flex h-[30px] w-[43px] items-center justify-center rounded-[2.5px] border border-[#D9D9D9] bg-white text-[8px] font-bold italic text-[#172B85]">VISA</span>
          <span class="flex h-[30px] w-[43px] items-center justify-center rounded-[2.5px] border border-[#D9D9D9] bg-white text-[8px] font-bold text-[#0E4C96]">JCB</span>
          <span class="flex h-[30px] w-[43px] items-center justify-center gap-[1px] rounded-[2.5px] border border-[#D9D9D9] bg-white" title="Mastercard">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ED0006]/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#F9A000]/80"></span>
          </span>
          <span class="flex h-[30px] w-[43px] items-center justify-center rounded-[2.5px] border border-[#D9D9D9] bg-white text-[8px] font-bold italic text-[#253B80]">PayPal</span>
          <span class="flex h-[30px] w-[43px] items-center justify-center rounded-[2.5px] border border-[#D9D9D9] bg-white text-[8px] font-bold text-[#3C4043]">G Pay</span>
        </div>
      </div>
    </div>
  </div>

  {% comment %} Copyright {% endcomment %}
  <div class="mx-auto flex w-full max-w-[1440px] items-center justify-between px-4 py-5 sm:px-6 lg:px-[70px]">
    <p class="font-['Crimson_Text'] text-sm font-normal text-[#3D3B2F]">{{ 'footer.copyright' | t }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer (ANIA)",
  "settings": [
    {
      "type": "text",
      "id": "order_heading",
      "label": "Order section heading",
      "default": "Find your Perfect Bouquet today!"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email field label",
      "default": "Email address"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact / consultation link"
    },
    {
      "type": "link_list",
      "id": "menu_shop",
      "label": "Shop menu",
      "info": "Falls back to the default ANIA shop links when empty."
    },
    {
      "type": "link_list",
      "id": "menu_resources",
      "label": "Resources menu"
    }
  ]
}
{% endschema %}

