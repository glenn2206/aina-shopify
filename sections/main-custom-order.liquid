{%- liquid
  assign co_link = section.settings.link | default: routes.root_url
  assign co_eyebrow = 'custom_order.eyebrow' | t
  assign co_cta_label = 'custom_order.cta' | t
  assign co_cta_href = co_link | append: '#contact'
-%}

{% stylesheet %}
  #contact .co-grid { display: grid; grid-template-columns: 1fr; align-items: center; gap: var(--space-10); }
  #contact .co-heading { font-family: var(--font-heading); font-size: clamp(2.25rem, 1.9rem + 1.6vw, 3.75rem); line-height: 1.12; color: var(--color-heading); margin-top: var(--space-6); }
  #contact .co-body { margin-top: var(--space-8); max-width: 449px; }
  #contact .co-media { display: block; width: 100%; height: auto; object-fit: cover; }
  #contact .co-cta { margin-top: var(--space-8); }
  @media (min-width: 1024px) {
    #contact .co-grid { grid-template-columns: 1fr 1fr; gap: var(--space-12); }
  }
{% endstylesheet %}

<section id="contact" class="lib-scope" style="background:var(--color-bg); padding-block:60px">
  <div class="lib-container co-grid">
    <div>
      <img
        class="co-media"
        src="{{ 'custom.png' | asset_url }}"
        alt="{{ 'custom_order.img_alt' | t }}"
        width="1538"
        height="992"
        loading="lazy"
      >
    </div>

    <div style="max-width:535px">
      {% render 'lib-badge', label: co_eyebrow, type: 'eyebrow' %}
      <h2 class="co-heading">{{ 'custom_order.heading' | t }}</h2>
      <p class="co-body">{{ 'custom_order.body' | t }}</p>
      <div class="co-cta">
        {% render 'lib-button', href: co_cta_href, label: co_cta_label, variant: 'primary', size: 'sm' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Order (ANIA)",
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "CTA link"
    }
  ],
  "presets": [
    {
      "name": "Custom Order (ANIA)",
      "category": "ANIA"
    }
  ]
}
{% endschema %}
