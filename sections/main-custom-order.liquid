{% comment %}
  Custom Order — "Have Something Special in Mind?" (Figma node 137:1006).
  Rebuild of src astro/components/sections/CustomOrder.astro (pixel-by-pixel).
{% endcomment %}
{%- liquid
  assign co_link = section.settings.link | default: routes.root_url
-%}

<section id="contact" class="bg-[#FAFAF2] py-[60px] lg:py-[90px]">
  <div class="mx-auto grid w-full max-w-[1440px] grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-[50px] lg:px-[70px]">
    <div class="relative">
      <img
        src="{{ 'custom.png' | asset_url }}"
        alt="Rangkaian bunga kustom ANIA"
        class="w-full object-cover"
        width="1538"
        height="992"
        loading="lazy"
      >
    </div>

    <div class="max-w-[535px]">
      <p class="text-[13px] font-semibold uppercase tracking-[5.6px] text-[#525252] sm:text-[14px]">Have Something Special in Mind?</p>
      <h2 class="mt-6 font-['Cormorant_Garamond'] text-4xl font-normal leading-[1.12] text-[#525252] sm:text-5xl lg:text-[60px]">We'd love to make it personal.</h2>
      <p class="mt-7 max-w-[449px] text-sm font-normal leading-relaxed text-[#525252]">Have a specific flower, colour, budget, or special request in mind? Tell us the details, and our florist will help create something made just for you.</p>

      <a
        href="{{ co_link }}#contact"
        class="mt-9 flex h-9 w-fit items-center justify-center rounded-lg bg-[#899B7A] px-[18px] text-xs font-semibold uppercase tracking-[0.5px] text-white transition-colors duration-200 hover:bg-[#7a8c6b]"
      >
        Let's Create Your Flowers
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Order (ANIA)",
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "CTA link"
    }
  ],
  "presets": [
    {
      "name": "Custom Order (ANIA)",
      "category": "ANIA"
    }
  ]
}
{% endschema %}
