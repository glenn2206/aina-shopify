{% comment %}
  FAQ — contoh implementasi Component Library di homepage.
  Pakai komponen asli lib-faq-accordion.liquid (sama PERSIS dengan yang
  dirender di /pages/components) dalam mode parallel array
  (questions/categories/answers).

  Semua teks lewat locale (locales/en.default.json + locales/id.json, key
  "home_faq") — bukan hardcode di Liquid — supaya language toggle ENG/IND
  di navbar konsisten seperti section lain. Setting "heading"/"subheading"
  di Theme Editor tetap bisa override manual kalau perlu.

  CSS & JS library dimuat SEKALI oleh layout/theme.liquid untuk halaman index —
  tidak perlu (dan tidak boleh) di-load ulang di sini supaya lib-components.js
  tidak mengeksekusi init dua kali (event listener ganda).
{% endcomment %}
{%- liquid
  assign heading_default = 'home_faq.heading' | t
  assign subheading_default = 'home_faq.subheading' | t
  assign heading = section.settings.heading | default: heading_default
  assign subheading = section.settings.subheading | default: subheading_default

  assign faq_q1 = 'home_faq.q1_question' | t
  assign faq_q2 = 'home_faq.q2_question' | t
  assign faq_q3 = 'home_faq.q3_question' | t
  assign faq_q4 = 'home_faq.q4_question' | t
  assign faq_c1 = 'home_faq.q1_category' | t
  assign faq_c2 = 'home_faq.q2_category' | t
  assign faq_c3 = 'home_faq.q3_category' | t
  assign faq_c4 = 'home_faq.q4_category' | t
  assign faq_a1 = 'home_faq.q1_answer' | t
  assign faq_a2 = 'home_faq.q2_answer' | t
  assign faq_a3 = 'home_faq.q3_answer' | t
  assign faq_a4 = 'home_faq.q4_answer' | t

  assign faq_questions = faq_q1 | append: '||' | append: faq_q2 | append: '||' | append: faq_q3 | append: '||' | append: faq_q4 | split: '||'
  assign faq_categories = faq_c1 | append: '||' | append: faq_c2 | append: '||' | append: faq_c3 | append: '||' | append: faq_c4 | split: '||'
  assign faq_answers = faq_a1 | append: '||' | append: faq_a2 | append: '||' | append: faq_a3 | append: '||' | append: faq_a4 | split: '||'
-%}

<section id="home-faq" class="lib-scope" style="background:var(--color-bg-alt); padding-block:60px">
  <div class="lib-container">
    <h2 class="section-heading">{{ heading }}</h2>
    <p class="section-subheading">{{ subheading }}</p>

    <div style="margin-top:var(--space-10)">
      {% render 'lib-faq-accordion', questions: faq_questions, categories: faq_categories, answers: faq_answers %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ (Library Demo)",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Kosongkan untuk pakai teks default dari locale (home_faq.heading)"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "info": "Kosongkan untuk pakai teks default dari locale (home_faq.subheading)"
    }
  ],
  "presets": [
    {
      "name": "FAQ (Library Demo)",
      "category": "ANIA"
    }
  ]
}
{% endschema %}
