{% comment %}
  FAQ — contoh implementasi Component Library (/coba) di homepage.
  Pakai lib-faq-accordion.liquid + assets/lib-components.css/.js — komponen
  yang SAMA PERSIS dengan yang ada di halaman /pages/components.

  Section ini BARU — tidak mengubah section homepage yang sudah ada sama
  sekali. Reset CSS dasar di-scope ke #home-faq supaya tidak bentrok dengan
  Tailwind (ania.css) yang dipakai section lain di halaman yang sama.
{% endcomment %}

{{ 'lib-components.css' | asset_url | stylesheet_tag }}

<section id="home-faq" class="lib-scope" style="background:var(--color-bg-alt); padding-block:60px">
  <div class="lib-container" style="max-width:1440px">
    <h2 class="section-heading">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h2>
    <p class="section-subheading">{{ section.settings.subheading | default: 'Semua yang perlu Anda tahu sebelum memesan bunga di ANIA.' }}</p>

    <div style="margin-top:40px">
      {%- liquid
        assign faq_questions = 'How Long Does Delivery Take, and How Much Will It Cost?,Bisakah saya request custom bouquet?,Apakah bunga dijamin segar sampai tujuan?,Metode pembayaran apa saja yang tersedia?' | split: ','
        assign faq_categories = 'Delivery,Custom Order,Freshness Guarantee,Payment' | split: ','
        assign faq_answers = 'Our delivery starts from 10 a.m. to 10 p.m. (WIB) for Same-Day Delivery. If you need flowers before 10 a.m., please complete your purchase at least one day before (D-1).,Tentu! Hubungi tim kami lewat halaman Custom Order untuk konsultasi gratis mengenai bouquet impian Anda.,Ya — setiap pesanan dipilih dan dirangkai dengan bunga segar pilihan pada hari pengiriman. Kalau ada masalah, kami ganti gratis.,Kami menerima kartu kredit/debit, transfer bank, QRIS, dan e-wallet populer melalui checkout Shopify.' | split: ','
      -%}
      <div class="faq-list" data-component="faq">
        {% for question in faq_questions %}
          <div class="faq-item{% if forloop.first %} is-open{% endif %}" data-faq-item>
            <button type="button" class="faq-item__toggle" data-faq-toggle aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
              <span class="faq-item__heading">
                <span class="faq-item__question">{{ question }}</span>
                <span class="faq-item__category">{{ faq_categories[forloop.index0] }}</span>
              </span>
              <span class="faq-item__icon" aria-hidden="true"></span>
            </button>
            <div class="faq-item__answer">
              <div class="faq-item__answer-inner">{{ faq_answers[forloop.index0] }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{{ 'lib-components.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "FAQ (Library Demo)",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Semua yang perlu Anda tahu sebelum memesan bunga di ANIA."
    }
  ],
  "presets": [
    {
      "name": "FAQ (Library Demo)",
      "category": "ANIA"
    }
  ]
}
{% endschema %}
