{% comment %}
  Main Hero — Landing slider ANIA (responsive).
  Rebuild of src astro/components/Landing.astro (pixel-by-pixel):
    autoplay 5s, ken-burns, progress bars, prev/next, swipe,
    auto-scroll to 100vh after the last slide.
{% endcomment %}
{%- liquid
  assign slides_count = 3
  assign cta_href = routes.all_products_collection_url
-%}

<section
  data-hero
  class="relative w-full overflow-hidden bg-[#3B3A2F]"
  aria-roledescription="carousel"
  aria-label="{{ 'hero.carousel_label' | t }}"
>
  <div data-hero-track class="flex transition-transform duration-900 ease-[cubic-bezier(0.22,1,0.36,1)]">
    {% comment %} Slide 1 {% endcomment %}
    <div data-hero-slide class="relative w-full shrink-0 is-active" role="group" aria-roledescription="slide" aria-label="{{ 'hero.slide_label' | t: index: 1, total: slides_count }}">
      <div class="absolute inset-0 overflow-hidden">
        <img
          data-hero-img
          class="h-full w-full object-cover object-center"
          src="{{ 'hero-1.png' | asset_url }}"
          alt="{{ 'hero.img_alt_1' | t }}"
          width="1440"
          height="939"
          loading="eager"
          fetchpriority="high"
        >
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#2B2E2B]/85 via-[#2B2E2B]/45 to-transparent"></div>

      <div data-hero-content-wrap class="relative z-10 flex min-h-[calc(100svh)] flex-col justify-center px-5 py-20 sm:px-8 sm:py-32 lg:min-h-[calc(100svh)] lg:px-[70px] lg:py-24">
        <div data-hero-content class="flex max-w-[621px] flex-col items-start gap-4">
          <p data-anim style="--d: 720ms" class="text-[10px] font-semibold uppercase tracking-[4px] text-[#CCC8A8]">{{ 'hero.eyebrow_1' | t }}</p>
          <h1 class="flex flex-col gap-5 sm:gap-6">
            <span data-anim style="--d: 840ms" class="font-['Cormorant_Garamond'] text-4xl font-normal leading-[1.15] text-[#BCC6BC] sm:text-5xl lg:text-7xl lg:leading-[87px]">{{ 'hero.title_line1_1' | t }}</span>
            <span data-anim style="--d: 960ms" class="font-['Cormorant_Garamond'] text-4xl font-semibold italic leading-[1.15] text-[#CCC8A8] sm:text-5xl lg:text-7xl lg:leading-[87px]">{{ 'hero.title_line2_1' | t }}</span>
          </h1>
          <p data-anim style="--d: 1080ms" class="mt-1 max-w-[520px] text-sm font-normal leading-6 text-[#CCC8A8]/90 sm:text-xs">{{ 'hero.body_1' | t }}</p>
          <div data-anim style="--d: 1200ms" class="mt-2 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center sm:gap-6">
            <a href="{{ cta_href }}" class="flex h-9 w-full items-center justify-center rounded-lg bg-[#CCC8A8] text-xs font-semibold text-black transition-colors duration-200 hover:bg-[#E8E3C8] sm:w-[150px]">{{ 'hero.view_collection' | t }}</a>
            <a href="{{ cta_href }}" class="flex h-9 w-full items-center justify-center rounded-lg border border-[#CCC8A8]/70 text-xs font-normal uppercase text-[#CCC8A8] transition-colors duration-200 hover:bg-[#CCC8A8]/10 sm:w-[150px]">{{ 'hero.view_catalogue' | t }}</a>
          </div>
        </div>
      </div>
    </div>

    {% comment %} Slide 2 {% endcomment %}
    <div data-hero-slide class="relative w-full shrink-0" role="group" aria-roledescription="slide" aria-label="{{ 'hero.slide_label' | t: index: 2, total: slides_count }}">
      <div class="absolute inset-0 overflow-hidden">
        <img
          data-hero-img
          class="h-full w-full object-cover object-center"
          src="{{ 'hero-2.png' | asset_url }}"
          alt="{{ 'hero.img_alt_2' | t }}"
          width="1440"
          height="815"
          loading="lazy"
        >
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#2B2E2B]/85 via-[#2B2E2B]/45 to-transparent"></div>

      <div data-hero-content-wrap class="relative z-10 flex min-h-[calc(100svh)] flex-col justify-center px-5 py-20 sm:px-8 sm:py-32 lg:min-h-[calc(100svh)] lg:px-[70px] lg:py-24">
        <div data-hero-content class="flex max-w-[621px] flex-col items-start gap-4">
          <p data-anim style="--d: 720ms" class="text-[10px] font-semibold uppercase tracking-[4px] text-[#CCC8A8]">{{ 'hero.eyebrow_2' | t }}</p>
          <h1 class="flex flex-col gap-5 sm:gap-6">
            <span data-anim style="--d: 840ms" class="font-['Cormorant_Garamond'] text-4xl font-normal leading-[1.15] text-[#BCC6BC] sm:text-5xl lg:text-7xl lg:leading-[87px]">{{ 'hero.title_line1_2' | t }}</span>
            <span data-anim style="--d: 960ms" class="font-['Cormorant_Garamond'] text-4xl font-semibold italic leading-[1.15] text-[#CCC8A8] sm:text-5xl lg:text-7xl lg:leading-[87px]">{{ 'hero.title_line2_2' | t }}</span>
          </h1>
          <p data-anim style="--d: 1080ms" class="mt-1 max-w-[520px] text-sm font-normal leading-6 text-[#CCC8A8]/90 sm:text-xs">{{ 'hero.body_2' | t }}</p>
          <div data-anim style="--d: 1200ms" class="mt-2 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center sm:gap-6">
            <a href="{{ cta_href }}" class="flex h-9 w-full items-center justify-center rounded-lg bg-[#CCC8A8] text-xs font-semibold text-black transition-colors duration-200 hover:bg-[#E8E3C8] sm:w-[150px]">{{ 'hero.view_collection' | t }}</a>
            <a href="{{ cta_href }}" class="flex h-9 w-full items-center justify-center rounded-lg border border-[#CCC8A8]/70 text-xs font-normal uppercase text-[#CCC8A8] transition-colors duration-200 hover:bg-[#CCC8A8]/10 sm:w-[150px]">{{ 'hero.view_catalogue' | t }}</a>
          </div>
        </div>
      </div>
    </div>
    {% comment %} Slide 3 {% endcomment %}
    <div data-hero-slide class="relative w-full shrink-0" role="group" aria-roledescription="slide" aria-label="{{ 'hero.slide_label' | t: index: 3, total: slides_count }}">
      <div class="absolute inset-0 overflow-hidden">
        <img
          data-hero-img
          class="h-full w-full object-cover object-center"
          src="{{ 'hero-3.png' | asset_url }}"
          alt="{{ 'hero.img_alt_1' | t }}"
          width="1440"
          height="815"
          loading="lazy"
        >
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#2B2E2B]/85 via-[#2B2E2B]/45 to-transparent"></div>

      <div data-hero-content-wrap class="relative z-10 flex min-h-[calc(100svh)] flex-col justify-center px-5 py-20 sm:px-8 sm:py-32 lg:min-h-[calc(100svh)] lg:px-[70px] lg:py-24">
        <div data-hero-content class="flex max-w-[621px] flex-col items-start gap-4">
          <p data-anim style="--d: 720ms" class="text-[10px] font-semibold uppercase tracking-[4px] text-[#CCC8A8]">{{ 'hero.eyebrow_1' | t }}</p>
          <h1 class="flex flex-col gap-5 sm:gap-6">
            <span data-anim style="--d: 840ms" class="font-['Cormorant_Garamond'] text-4xl font-normal leading-[1.15] text-[#BCC6BC] sm:text-5xl lg:text-7xl lg:leading-[87px]">{{ 'hero.title_line1_1' | t }}</span>
            <span data-anim style="--d: 960ms" class="font-['Cormorant_Garamond'] text-4xl font-semibold italic leading-[1.15] text-[#CCC8A8] sm:text-5xl lg:text-7xl lg:leading-[87px]">{{ 'hero.title_line2_1' | t }}</span>
          </h1>
          <p data-anim style="--d: 1080ms" class="mt-1 max-w-[520px] text-sm font-normal leading-6 text-[#CCC8A8]/90 sm:text-xs">{{ 'hero.body_1' | t }}</p>
          <div data-anim style="--d: 1200ms" class="mt-2 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center sm:gap-6">
            <a href="{{ cta_href }}" class="flex h-9 w-full items-center justify-center rounded-lg bg-[#CCC8A8] text-xs font-semibold text-black transition-colors duration-200 hover:bg-[#E8E3C8] sm:w-[150px]">{{ 'hero.view_collection' | t }}</a>
            <a href="{{ cta_href }}" class="flex h-9 w-full items-center justify-center rounded-lg border border-[#CCC8A8]/70 text-xs font-normal uppercase text-[#CCC8A8] transition-colors duration-200 hover:bg-[#CCC8A8]/10 sm:w-[150px]">{{ 'hero.view_catalogue' | t }}</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% comment %} Indikator / progress slide (tengah bawah) {% endcomment %}
  <div class="absolute bottom-6 left-1/2 z-20 flex -translate-x-1/2 items-center gap-2 sm:gap-3 lg:bottom-[48px]">
    {% for i in (1..slides_count) %}
      <button
        type="button"
        data-progress
        data-progress-index="{{ forloop.index0 }}"
        class="h-0.5 w-12 cursor-pointer overflow-hidden rounded-full bg-white/25 transition-colors duration-300 hover:bg-white/40 sm:w-20 lg:w-32"
        aria-label="{{ 'hero.go_to_slide' | t: index: forloop.index }}"
      >
        <span data-progress-fill class="block h-full w-0 bg-[#FCF6F3]"></span>
      </button>
    {% endfor %}
  </div>

  {% comment %} Panah prev / next (vertikal tengah kiri & kanan) {% endcomment %}
  <button
    type="button"
    data-hero-prev
    class="absolute left-4 top-1/2 z-20 flex size-9 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-[#CCC8A8]/40 text-[#CCC8A8] transition-colors duration-200 hover:bg-[#CCC8A8] hover:text-[#3B3A2F] sm:left-6 sm:size-10 lg:left-8"
    aria-label="{{ 'hero.prev_slide' | t }}"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button
    type="button"
    data-hero-next
    class="absolute right-4 top-1/2 z-20 flex size-9 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-[#CCC8A8]/40 text-[#CCC8A8] transition-colors duration-200 hover:bg-[#CCC8A8] hover:text-[#3B3A2F] sm:right-6 sm:size-10 lg:right-8"
    aria-label="{{ 'hero.next_slide' | t }}"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</section>

<script>
  (() => {
    const section = document.querySelector('[data-hero]');
    if (!section) return;
    const track = section.querySelector('[data-hero-track]');
    const slides = [...section.querySelectorAll('[data-hero-slide]')];
    const progressBars = [...section.querySelectorAll('[data-progress]')];
    const fills = progressBars.map((bar) => bar.querySelector('[data-progress-fill]'));
    const prevBtn = section.querySelector('[data-hero-prev]');
    const nextBtn = section.querySelector('[data-hero-next]');

    if (!track || slides.length < 2) return;

    const DURATION = 5000;

    let current = 0;
    let timer = null;
    let paused = false;

    // Once the visitor takes control of the scroll themselves, the
    // "advance past the hero" auto-scroll below must never fire again —
    // otherwise it yanks them back down mid-read whenever the slideshow
    // loops back around to the last slide.
    let userScrolled = false;
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 40) userScrolled = true;
      },
      { passive: true }
    );

    const clearTimer = () => {
      if (timer) {
        clearTimeout(timer);
        timer = null;
      }
    };

    const schedule = () => {
      clearTimer();
      if (paused) return;
      timer = setTimeout(() => nextSlide(), DURATION);
    };

    const setProgress = (idx) => {
      fills.forEach((fill, i) => {
        fill.style.transition = 'none';
        fill.style.width = i < idx ? '100%' : '0%';
      });
      const fill = fills[idx];
      if (!fill) return;
      void fill.offsetWidth;
      fill.style.transition = `width ${DURATION}ms linear`;
      fill.style.width = '100%';
    };

    const goTo = (idx) => {
      current = idx;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === current));
      track.style.transform = `translateX(-${current * 100}%)`;
      setProgress(current);
      schedule();
    };

    const nextSlide = () => {
      if (current === slides.length - 1) {
        clearTimer();
        // Only auto-scroll if the visitor is still sitting at the hero —
        // if they've already scrolled away (reading the page below, or
        // came back around to the last slide again later), leave their
        // scroll position alone.
        if (!userScrolled && window.scrollY <= 40) {
          // Scroll by the hero's actual height so it never stops mid-hero
          // (which makes the background look "cut off" at the edge of the screen).
          window.scrollBy({
            top: section.getBoundingClientRect().height,
            behavior: 'smooth',
          });
        }
      } else {
        goTo(current + 1);
      }
    };

    const setPaused = (value) => {
      paused = value;
      if (paused) {
        clearTimer();
      } else {
        setProgress(current);
        schedule();
      }
    };

    setProgress(0);
    schedule();

    nextBtn?.addEventListener('click', () => nextSlide());
    prevBtn?.addEventListener('click', () => goTo((current - 1 + slides.length) % slides.length));
    progressBars.forEach((bar, i) => bar.addEventListener('click', () => goTo(i)));

    document.addEventListener('visibilitychange', () => setPaused(document.hidden));

    let startX = null;
    section.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
    });
    section.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) < 50) return;
      if (dx < 0) nextSlide();
      else goTo((current - 1 + slides.length) % slides.length);
    });
  })();
</script>

