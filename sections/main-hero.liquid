{% comment %}
  Main Hero — Landing slider ANIA (component-based).
  Rebuild di atas komponen "Hero Slider" dari Component Library:
    - markup: .hero / .hero__track / .hero__slide / .hero__scrim /
      .hero__content-wrap / .hero__content / .hero__progress / .hero__arrow
    - behaviour: assets/lib-components.js → initHero (auto-slide 5s, progress
      bar, prev/next, wrap-around)
  Sesuai perilaku komponen, teks hero FIXED (SATU blok di atas semua slide) —
  hanya foto di belakang yang berganti.
  CSS & JS library dimuat sekali oleh layout/theme.liquid untuk halaman index.
{% endcomment %}
{%- liquid
  assign slides_count = 3
  assign cta_href = routes.all_products_collection_url
  assign hero_alt_1 = 'hero.img_alt_1' | t
  assign hero_alt_2 = 'hero.img_alt_2' | t
  assign hero_eyebrow = 'hero.eyebrow_1' | t
  assign hero_view_collection = 'hero.view_collection' | t
  assign hero_view_catalogue = 'hero.view_catalogue' | t
-%}

<section class="lib-scope" style="padding:0; background:#3B3A2F">
  <div class="hero" data-component="hero">
    <div class="hero__track" data-hero-track>
      <div class="hero__slide" data-hero-slide>
        <img src="{{ 'hero-1.png' | asset_url }}" loading="eager" alt="{{ hero_alt_1 }}">
      </div>
      <div class="hero__slide" data-hero-slide>
        <img src="{{ 'hero-2.png' | asset_url }}" loading="lazy" alt="{{ hero_alt_2 }}">
      </div>
      <div class="hero__slide" data-hero-slide>
        <img src="{{ 'hero-3.png' | asset_url }}" loading="lazy" alt="{{ hero_alt_1 }}">
      </div>
    </div>

    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__content-wrap">
      <div class="hero__content">
        {% render 'lib-badge', label: "ANIA Flower Boutique", type: 'eyebrow', variant: 'on-dark' %}
        <h1 class="hero__title">
          <span>{{ "Looking for the Perfect Flowers Today?" }}</span>
          <span style="display:block; font-style:italic">{{ 'We’ve Got You.' }}</span>
        </h1>
        <p class="hero__checklist">
          ✔ Handcrafted by Florists<br>
          ✔ Professionally arranged for 10+ years <br>
          ✔ Easy online ordering system<br>
          ✔ Same-Day Flower Delivery<br>
        </p>
        <div class="hero__cta">
          {% render 'lib-button', href: cta_href, label: hero_view_collection, variant: 'primary' %}
          {% render 'lib-button', href: cta_href, label: hero_view_catalogue, variant: 'outline-light' %}
        </div>
      </div>
    </div>

    {% comment %} Indikator / progress slide (tengah bawah) {% endcomment %}
    <div class="hero__progress">
      {% for i in (1..slides_count) %}
        <button
          type="button"
          class="hero__progress-bar"
          data-progress
          data-progress-index="{{ forloop.index0 }}"
          aria-label="{{ 'hero.go_to_slide' | t: index: forloop.index }}"
        >
          <span class="hero__progress-fill" data-progress-fill></span>
        </button>
      {% endfor %}
    </div>

    {% comment %} Panah prev / next (vertikal tengah kiri & kanan) {% endcomment %}
    <button
      type="button"
      class="btn-circle hero__arrow hero__arrow--prev"
      data-hero-prev
      aria-label="{{ 'hero.prev_slide' | t }}"
      style="border-color:var(--color-on-dark-muted); color:var(--color-on-dark-muted)"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button
      type="button"
      class="btn-circle hero__arrow hero__arrow--next"
      data-hero-next
      aria-label="{{ 'hero.next_slide' | t }}"
      style="border-color:var(--color-on-dark-muted); color:var(--color-on-dark-muted)"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</section>

{% schema %}
{
  "name": "Hero (ANIA slider)",
  "settings": [],
  "presets": [
    {
      "name": "Hero (ANIA slider)",
      "category": "ANIA"
    }
  ]
}
{% endschema %}