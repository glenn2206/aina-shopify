            <a href="{{ cta_href }}" class="flex h-9 w-full items-center justify-center rounded-lg bg-[#CCC8A8] text-xs font-semibold text-black transition-colors duration-200 hover:bg-[#E8E3C8] sm:w-[150px]">VIEW COLLECTION</a>
