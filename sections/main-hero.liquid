    {% comment %} Slide 3 {% endcomment %}
    <div data-hero-slide class="relative w-full shrink-0" role="group" aria-roledescription="slide" aria-label="Slide 3 dari {{ slides_count }}">
      <div class="absolute inset-0 overflow-hidden">
        <img
