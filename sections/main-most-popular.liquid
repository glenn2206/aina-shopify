{% comment %}
  Most Popular — "Flowers They'll Never Forget" (component-based).
  Rebuild pakai Component Library: lib-section-heading + lib-product-card +
  lib-button — snippet yang SAMA PERSIS dengan halaman /pages/components.
  CSS & JS library dimuat sekali oleh layout/theme.liquid untuk halaman index.
{% endcomment %}
{%- liquid
  assign mp_heading_default = 'most_popular.heading' | t
  assign mp_heading = section.settings.heading | default: mp_heading_default
  assign mp_subheading_default = 'most_popular.subheading' | t
  assign mp_subheading = section.settings.subheading | default: mp_subheading_default
  assign mp_products = section.settings.collection.products
  if mp_products.size == 0
    assign mp_products = collections.all.products
  endif
  assign mp_button_default = 'most_popular.button' | t
  assign mp_button = section.settings.button_label | default: mp_button_default
  assign mp_button_url = section.settings.collection.url | default: routes.all_products_collection_url
-%}

<section class="lib-scope" style="background:var(--color-bg-alt); padding-block:50px">
  <div class="lib-container">
    {% render 'lib-section-heading', heading: mp_heading, subheading: mp_subheading, alt_font: true %}

    <div class="grid grid--4" style="margin-top:var(--space-12)">
      {% for product in collections['all'].products limit: 4 %}
        {% render 'lib-product-card', product: product %}
      {% endfor %}
    </div>

    <div style="margin-top:var(--space-12); text-align:center">
      {% render 'lib-button', href: mp_button_url, label: mp_button, variant: 'primary' %}
    </div>
  </div>

  <div style="margin-top:var(--space-12); height:1px; background:var(--color-border)"></div>
</section>

{% schema %}
{
  "name": "Most Popular (ANIA)",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Defaults to all products when empty."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Flowers They'll Never Forget"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our ready-to-send bouquets, thoughtfully arranged and ready to make someone’s day."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All Product"
    }
  ],
  "presets": [
    {
      "name": "Most Popular (ANIA)",
      "category": "ANIA"
    }
  ]
}
{% endschema %}
