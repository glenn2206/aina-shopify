{% comment %}
  Occasions — "Find the Perfect Flowers for Every Moment." (component-based).
  Rebuild pakai Component Library:
    - heading: class .section-heading (dari lib-components.css)
    - tabs: .tab-card / .tabs / .tab / .tab-panel — perilaku di-handle
      assets/lib-components.js → initTabs
    - kartu: lib-picker-card (sama dengan halaman /pages/components)
    - CTA: markup sama dengan lib-button (.btn btn--primary btn--sm)
  Script kecil di bawah cuma memperbarui label CTA sesuai tab aktif.

  Tab Occasions / Category / Flower tetap fungsional: setiap panel diisi data
  produk asli dan semua link deep-link ke grid produk dengan
  ?occasion=/?category=/?flower= (dibaca sections/main-products.liquid).
{% endcomment %}
{%- liquid
  assign occasions_url = pages.occasions.url | default: '/pages/occasions'
  assign shop_url = routes.all_products_collection_url
-%}

{%- capture category_raw -%}
  {%- for product in collections.all.products -%}
    {%- assign cat = product.category.name | default: product.type -%}
    {%- if cat != blank -%}{{ cat | strip }}||{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign category_list = category_raw | split: '||' | uniq | sort -%}
{%- assign category_top = category_list | slice: 0, 3 -%}

{%- capture flower_raw -%}
  {%- for product in collections.all.products -%}
    {%- assign flower_items = product.metafields.shopify['plant-class'].value -%}
    {%- for mo in flower_items -%}
      {%- liquid
        assign label = mo.label | default: mo.name | default: mo.title
        if label == blank and mo.first == nil
          assign label = mo
        endif
      -%}
      {%- if label != blank -%}{{ label | strip }}||{%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign flower_list = flower_raw | split: '||' | uniq | sort -%}
{%- assign flower_top = flower_list | slice: 0, 3 -%}

{% stylesheet %}
  #occasions .lib-panel-intro { margin-bottom: var(--space-6); max-width: 630px; }
  #occasions .lib-panel-empty { margin-top: var(--space-6); color: var(--color-muted); }
{% endstylesheet %}

<section id="occasions" class="lib-scope" style="background:var(--color-bg); padding-block:60px">
  <div class="lib-container">
    <h2 class="section-heading">
      {{ 'occasions.heading' | t }}
      <span style="display:block; font-style:italic">{{ 'occasions.heading_italic' | t }}</span>
    </h2>

    <div class="tab-card" data-component="tabs" style="margin-top:var(--space-10)">
      {% comment %} Tabs {% endcomment %}
      <div class="">
        <button type="button" class="tab" data-tab="occasions" aria-pressed="true">
          {{ 'occasions.tab_occasions' | t }}
          <span class="tab__underline" aria-hidden="true"></span>
        </button>
        <button type="button" class="tab" data-tab="category" aria-pressed="false">
          {{ 'occasions.tab_category' | t }}
          <span class="tab__underline" aria-hidden="true"></span>
        </button>
        <button type="button" class="tab" data-tab="flower" aria-pressed="false">
          {{ 'occasions.tab_flower' | t }}
          <span class="tab__underline" aria-hidden="true"></span>
        </button>
      </div>

      {% comment %} Panel: Occasions (curated cards) {% endcomment %}
      <div class="tab-panel is-active" data-tab-panel="occasions">
        <p class="lib-panel-intro">{{ 'occasions.body' | t }}</p>
        {%- liquid
          assign graduation_href = shop_url | append: '?occasion=Graduation'
          assign graduation_img = 'occas-graduation.png' | asset_url
          assign graduation_alt = 'occasions.img_alt_graduation' | t
          assign graduation_label = 'occasions.card_graduation' | t
          assign birthday_href = shop_url | append: '?occasion=Birthday'
          assign birthday_img = 'occas-birthday.png' | asset_url
          assign birthday_alt = 'occasions.img_alt_birthday' | t
          assign birthday_label = 'occasions.card_birthday' | t
          assign valentines_href = shop_url | append: '?occasion=Valentines'
          assign valentines_img = 'occas-valentines.png' | asset_url
          assign valentines_alt = 'occasions.img_alt_valentines' | t
          assign valentines_label = 'occasions.card_valentines' | t
        -%}

        {% comment %}
          Navigasi 3 halaman (client-side, tanpa reload) — cuma 3 foto occasion
          yang ada di assets/, jadi tiap "halaman" nampilin 3 kartu yang sama
          dengan urutan/highlight dirotasi. Kalau nanti nambah foto occasion
          baru, tinggal bikin blok data-pagination-panel="3", "4", dst dan
          update total: di lib-pagination-client.
        {% endcomment %}
        <div data-component="pagination">
          <div class="grid grid--3" data-pagination-panel="0">
            {% render 'lib-picker-card', href: graduation_href, image_src: graduation_img, alt: graduation_alt, label: graduation_label, highlighted: true %}
            {% render 'lib-picker-card', href: birthday_href, image_src: birthday_img, alt: birthday_alt, label: birthday_label %}
            {% render 'lib-picker-card', href: valentines_href, image_src: valentines_img, alt: valentines_alt, label: valentines_label %}
          </div>
          <div class="grid grid--3" data-pagination-panel="1" hidden>
            {% render 'lib-picker-card', href: birthday_href, image_src: birthday_img, alt: birthday_alt, label: birthday_label, highlighted: true %}
            {% render 'lib-picker-card', href: valentines_href, image_src: valentines_img, alt: valentines_alt, label: valentines_label %}
            {% render 'lib-picker-card', href: graduation_href, image_src: graduation_img, alt: graduation_alt, label: graduation_label %}
          </div>
          <div class="grid grid--3" data-pagination-panel="2" hidden>
            {% render 'lib-picker-card', href: valentines_href, image_src: valentines_img, alt: valentines_alt, label: valentines_label, highlighted: true %}
            {% render 'lib-picker-card', href: graduation_href, image_src: graduation_img, alt: graduation_alt, label: graduation_label %}
            {% render 'lib-picker-card', href: birthday_href, image_src: birthday_img, alt: birthday_alt, label: birthday_label %}
          </div>

          <div style="display:flex; justify-content:flex-end; margin-top:var(--space-4)">
            {% render 'lib-pagination-client', total: 3 %}
          </div>
        </div>
      </div>

      {% comment %} Panel: Category (real product categories) {% endcomment %}
      <div class="tab-panel" data-tab-panel="category">
        <p class="lib-panel-intro">{{ 'occasions.body_category' | t }}</p>
        {% if category_top.size > 0 %}
          <div class="grid grid--3">
            {% for cat in category_top %}
              {% assign cat_image = nil %}
              {% for product in collections.all.products %}
                {% assign p_cat = product.category.name | default: product.type %}
                {% if p_cat == cat %}
                  {% assign cat_image = product.featured_image %}
                  {% break %}
                {% endif %}
              {% endfor %}
              {% assign cat_encoded = cat | url_encode %}
              {% assign cat_href = shop_url | append: '?category=' | append: cat_encoded %}
              {% assign cat_image_url = cat_image | image_url: width: 640 %}
              {% render 'lib-picker-card', href: cat_href, image_src: cat_image_url, alt: cat, label: cat, highlighted: forloop.first %}
            {% endfor %}
          </div>
        {% else %}
          <p class="lib-panel-empty">{{ 'occasions.empty_category' | t }}</p>
        {% endif %}
      </div>

      {% comment %} Panel: Flower (real flower/plant types) {% endcomment %}
      <div class="tab-panel" data-tab-panel="flower">
        <p class="lib-panel-intro">{{ 'occasions.body_flower' | t }}</p>
        {% if flower_top.size > 0 %}
          <div class="grid grid--3">
            {% for f in flower_top %}
              {% assign f_image = nil %}
              {% for product in collections.all.products %}
                {% assign flower_items = product.metafields.shopify['plant-class'].value %}
                {% assign p_matches = false %}
                {% for mo in flower_items %}
                  {% assign label = mo.label | default: mo.name | default: mo.title %}
                  {% if label == blank and mo.first == nil %}
                    {% assign label = mo %}
                  {% endif %}
                  {% if label == f %}
                    {% assign p_matches = true %}
                  {% endif %}
                {% endfor %}
                {% if p_matches %}
                  {% assign f_image = product.featured_image %}
                  {% break %}
                {% endif %}
              {% endfor %}
              {% assign f_encoded = f | url_encode %}
              {% assign f_href = shop_url | append: '?flower=' | append: f_encoded %}
              {% assign f_image_url = f_image | image_url: width: 640 %}
              {% render 'lib-picker-card', href: f_href, image_src: f_image_url, alt: f, label: f, highlighted: forloop.first %}
            {% endfor %}
          </div>
        {% else %}
          <p class="lib-panel-empty">{{ 'occasions.empty_flower' | t }}</p>
        {% endif %}
      </div>
    </div>

    <div style="margin-top:var(--space-10); text-align:center">
      {% comment %} Markup sama dengan lib-button (btn btn--primary btn--sm); perlu data-label-* untuk script di bawah. {% endcomment %}
      <a
        href="{{ occasions_url }}"
        data-teaser-cta
        data-label-occasions="{{ 'occasions.check_other' | t }}"
        data-label-category="{{ 'occasions.check_other_category' | t }}"
        data-label-flower="{{ 'occasions.check_other_flower' | t }}"
        class="btn btn--primary btn--sm"
      >{{ 'occasions.check_other' | t }}</a>
    </div>
  </div>
</section>

<script>
  // Perilaku tab (aria-pressed + tampil/sembunyi panel) di-handle
  // lib-components.js → initTabs. Script ini cuma memperbarui label CTA.
  (() => {
    const tabs = Array.from(document.querySelectorAll('#occasions [data-tab]'));
    const cta = document.querySelector('[data-teaser-cta]');
    if (!tabs.length || !cta) return;
    const update = (name) => {
      const key = `label${name.charAt(0).toUpperCase()}${name.slice(1)}`;
      const label = cta.dataset[key];
      if (label) cta.textContent = label;
    };
    tabs.forEach((tab) => tab.addEventListener('click', () => update(tab.dataset.tab)));
  })();

  // Perilaku pagination (aktif/disabled + dispatch event) di-handle
  // lib-components.js → initPagination. Script ini cuma toggle panel kartu
  // mana yang tampil sesuai halaman yang diklik.
  (() => {
    const root = document.querySelector('#occasions [data-component="pagination"]');
    if (!root) return;
    const panels = Array.from(root.querySelectorAll('[data-pagination-panel]'));
    root.addEventListener('pagination:change', (e) => {
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.paginationPanel !== String(e.detail.index);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Occasions (ANIA)",
  "settings": [],
  "presets": [
    {
      "name": "Occasions (ANIA)",
      "category": "ANIA"
    }
  ]
}
{% endschema %}
