{% comment %}
  Occasions — "Find the Perfect Flowers for Every Moment."
  Rebuild of src astro/components/sections/Occasions.astro (pixel-by-pixel).
  Homepage teaser only — the full standalone page lives at
  snippets/occasions-page.liquid (pages.occasions.url), which this section's
  "Check Other occasions" button links to.
{% endcomment %}
{%- liquid
  assign occasions_url = pages.occasions.url | default: '/pages/occasions'
-%}

<section id="occasions" class="bg-[#FAFAF2] pb-[90px] pt-[60px] lg:pb-[110px]">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-[70px]">
    <h2 class="mx-auto max-w-[620px] text-center font-['Cormorant_Garamond'] text-3xl font-medium leading-tight text-[#1E2934] lg:text-[32px]">
      {{ 'occasions.heading' | t }}
      <span class="mt-1 block font-normal italic">{{ 'occasions.heading_italic' | t }}</span>
    </h2>

    <div class="relative mt-10 rounded-[6px] border border-[#CCC8A8] px-5 pb-8 pt-6 sm:px-8 lg:px-[30px] lg:pt-7">
      {% comment %} Tabs {% endcomment %}
      <div class="flex items-baseline gap-8 lg:gap-[170px]">
        <button type="button" class="relative cursor-pointer border-0 bg-transparent p-0 font-['Crimson_Text'] text-2xl text-[#1E2934]" aria-pressed="true">
          {{ 'occasions.tab_occasions' | t }}
          <span class="absolute -bottom-2 left-0 h-px w-[118px] bg-[#525252]" aria-hidden="true"></span>
        </button>
        <button type="button" class="relative cursor-pointer border-0 bg-transparent p-0 font-['Crimson_Text'] text-2xl text-[#1E2934]/55" aria-pressed="false">{{ 'occasions.tab_category' | t }}</button>
        <button type="button" class="relative cursor-pointer border-0 bg-transparent p-0 font-['Crimson_Text'] text-2xl text-[#1E2934]/55" aria-pressed="false">{{ 'occasions.tab_flower' | t }}</button>
      </div>

      <p class="mt-8 max-w-[630px] text-sm font-normal leading-relaxed text-[#525252]">
        {{ 'occasions.body' | t }}
      </p>

      <div class="mt-6 grid grid-cols-1 gap-9 sm:grid-cols-2 xl:grid-cols-3">
        {% comment %} Kartu Graduation (bg olive, teks putih) {% endcomment %}
        <a href="{{ routes.all_products_collection_url }}?occasion=Graduation" class="group block">
          <div class="overflow-hidden rounded-[6px] bg-[#899B7A]">
            <div class="overflow-hidden">
              <img
                src="{{ 'occas-graduation.png' | asset_url }}"
                alt="{{ 'occasions.img_alt_graduation' | t }}"
                class="aspect-[401/468] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                width="802"
                height="936"
                loading="lazy"
              >
            </div>
            <div class="flex items-center justify-between px-5 py-5 text-white">
              <span class="font-['Cormorant_Garamond'] text-[32px] font-normal leading-none lg:text-[40px]">{{ 'occasions.card_graduation' | t }}</span>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 12h11m0 0-4.5-4.5M17 12l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </div>
        </a>

        {% comment %} Kartu Birthday (band border) {% endcomment %}
        <a href="{{ routes.all_products_collection_url }}?occasion=Birthday" class="group block">
          <div class="overflow-hidden rounded-[6px]">
            <div class="overflow-hidden">
              <img
                src="{{ 'occas-birthday.png' | asset_url }}"
                alt="{{ 'occasions.img_alt_birthday' | t }}"
                class="aspect-[401/468] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                width="802"
                height="936"
                loading="lazy"
              >
            </div>
            <div class="flex items-center justify-between border border-t-0 border-[#899B7A] px-5 py-5 text-[#525252]">
              <span class="font-['Cormorant_Garamond'] text-[32px] font-normal leading-none lg:text-[40px]">{{ 'occasions.card_birthday' | t }}</span>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 12h11m0 0-4.5-4.5M17 12l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </div>
        </a>

        {% comment %} Kartu Valentines (band border) {% endcomment %}
        <a href="{{ routes.all_products_collection_url }}?occasion=Valentines" class="group block">
          <div class="overflow-hidden rounded-[6px]">
            <div class="overflow-hidden">
              <img
                src="{{ 'occas-valentines.png' | asset_url }}"
                alt="{{ 'occasions.img_alt_valentines' | t }}"
                class="aspect-[401/468] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                width="802"
                height="936"
                loading="lazy"
              >
            </div>
            <div class="flex items-center justify-between border border-t-0 border-[#899B7A] px-5 py-5 text-[#525252]">
              <span class="font-['Cormorant_Garamond'] text-[32px] font-normal leading-none lg:text-[40px]">{{ 'occasions.card_valentines' | t }}</span>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 12h11m0 0-4.5-4.5M17 12l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </div>
        </a>
      </div>


      {% comment %} Pagination (kanan bawah) {% endcomment %}
      <div class="mt-8 hidden items-center gap-4 lg:absolute lg:bottom-[76px] lg:right-9 lg:mt-0 lg:flex">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M7 2 3 6l4 4" stroke="#A2A2A2" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div class="relative flex items-baseline gap-2 text-sm text-[#A2A2A2]">
          <span class="relative font-bold text-[#525252]">
            1
            <span class="absolute -bottom-[6px] left-0 h-px w-[20px] bg-[#525252]"></span>
          </span>
          <span>2</span>
          <span>3</span>
        </div>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="m5 2 4 4-4 4" stroke="#A2A2A2" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>

      <div class="mt-8 flex justify-center lg:mt-10">
        <a
          href="{{ occasions_url }}"
          class="flex h-9 items-center justify-center rounded-lg bg-[#899B7A] px-[18px] text-xs font-semibold uppercase tracking-[0.5px] text-white transition-colors duration-200 hover:bg-[#7a8c6b]"
        >
          {{ 'occasions.check_other' | t }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Occasions (ANIA)",
  "settings": [],
  "presets": [
    {
      "name": "Occasions (ANIA)",
      "category": "ANIA"
    }
  ]
}
{% endschema %}
