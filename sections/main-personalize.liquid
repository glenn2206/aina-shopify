{%- liquid
assign bg_color = section.settings.bg_color | default: '#FAF5EF'
assign card_border_color = section.settings.card_border_color | default: '#CCC8A8'
assign title_font_color = section.settings.title_color | default: '#1E2934'
-%}

<div class="lib-container" style="background:{{ bg_color }}; padding-block:50px">

  <section style="width: 100%; box-sizing: border-box;">
    <div style="max-width: 1300px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start;">
  
      <!-- Left Panel: Text Content & Action Button -->
      <div
        style="flex: 1 1 280px; max-width: 320px; display: flex; flex-direction: column; justify-content: space-between; align-self: stretch;">
        <div>
          <h2
            style="color: {{ title_font_color }}; font-family: 'Cormorant Garamond', 'Crimson Text', serif; font-size: 32px; font-weight: 500; margin: 0 0 16px 0; line-height: 1.2;">
            {{ section.settings.title | default: 'Make It Personal' }}
          </h2>
          {% if section.settings.description != blank %}
          <p
            style="color: #6B685B; font-family: 'Open Sans', sans-serif; font-size: 14px; line-height: 1.6; margin: 0 0 24px 0;">
            {{ section.settings.description }}
          </p>
          {% endif %}
        </div>
  
        {% if section.settings.button_label != blank %}
        <div style="margin-top: auto;">
          <a href="{{ section.settings.button_link | default: '#' }}"
            style="display: inline-flex; align-items: center; justify-content: center; padding: 10px 18px; background-color: #899B7A; color: #ffffff; font-size: 14px; font-weight: 600; text-transform: uppercase; border-radius: 8px; text-decoration: none; font-family: 'Open Sans', sans-serif;">
            {{ section.settings.button_label }}
          </a>
        </div>
        {% endif %}
      </div>
  
      <!-- Right Panel: Cards Grid -->
<div style="flex: 2 1 600px; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">

  {% assign addon_count = 0 %}
  {% for product in collections['all'].products %}
    {% if product.category.name contains 'Add-on' or product.category.name contains 'Customization' %}
      {% if addon_count < 3 %}
        <div
          style="display: flex; flex-direction: column; justify-content: space-between; padding: 15px; border: 1px solid {{ card_border_color | default: '#E0E0E0' }}; border-radius: 8px; min-height: 382px; background: transparent; box-sizing: border-box;"
          {{ block.shopify_attributes }}>
          
          {%- comment -%} Gambar Produk {%- endcomment -%}
          <div style="width: 100%; aspect-ratio: 1/1; border-radius: 8px; overflow: hidden; background-color: #EBE8D8; margin-bottom: 16px;">
            {%- assign featured_img = product.featured_image | default: product.images.first -%}
            {% if featured_img != blank %}
              <img src="{{ featured_img | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
            {% else %}
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #8C886B; font-family: sans-serif;">
                {{ product.title | default: 'Add-on' }}
              </div>
            {% endif %}
          </div>

          {%- comment -%} Detail Produk & Tombol {%- endcomment -%}
          <div style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%;">
            <div>
              <h3 style="color: {{ title_font_color | default: '#1E2934' }}; font-family: 'Crimson Text', serif; font-size: 20px; font-weight: 400; margin: 0 0 4px 0;">
                {{ product.title }}
              </h3>
              <span style="color: #1E2934; font-family: 'Open Sans', sans-serif; font-size: 16px;">
                {{ product.price | money }}
              </span>
            </div>

            {%- comment -%} Tombol Add to Cart / Select Variant {%- endcomment -%}
            {% assign current_variant = product.selected_or_first_available_variant %}
            <button type="button" class="js-add-addon-btn" data-variant-id="{{ current_variant.id }}" {% unless product.available %}disabled{% endunless %}
              style="width: 24px; height: 24px; border-radius: 50%; background-color: {% if product.available %}#CCC8A8{% else %}#E0E0E0{% endif %}; border: none; color: white; display: flex; align-items: center; justify-content: center; cursor: {% if product.available %}pointer{% else %}not-allowed{% endif %}; opacity: {% if product.available %}1{% else %}0.5{% endif %}; padding: 0;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 5v14m-7-7h14" />
              </svg>
            </button>
          </div>
        </div>

        {% comment %} Tambah counter setiap kali produk yang cocok ditampilkan {% endcomment %}
        {% assign addon_count = addon_count | plus: 1 %}
      {% else %}
        {% break %} {% comment %} Hentikan loop jika sudah mencapai 3 produk {% endcomment %}
      {% endif %}
    {% endif %}
  {% endfor %}

</div>
  
    </div>
  </section>
</div>

{% schema %}
{
"name": "Main Personalize",
"settings": [
{
"type": "color",
"id": "bg_color",
"label": "Background Color",
"default": "#FAF5EF"
},
{
"type": "color",
"id": "card_border_color",
"label": "Card Border Color",
"default": "#CCC8A8"
},
{
"type": "color",
"id": "title_color",
"label": "Text Color",
"default": "#1E2934"
},
{
"type": "text",
"id": "title",
"label": "Section Title",
"default": "Make It Personal"
},
{
"type": "textarea",
"id": "description",
"label": "Description",
"default": "Complete your bouquet with a special add-on, thoughtfully chosen to make your gift even more meaningful."
},
{
"type": "text",
"id": "button_label",
"label": "Button Label",
"default": "VIEW ALL ADD-ON"
},
{
"type": "url",
"id": "button_link",
"label": "Button Link"
}
],
"blocks": [
{
"type": "addon_card",
"name": "Add-on Item",
"settings": [
{
"type": "image_picker",
"id": "image",
"label": "Product Image"
},
{
"type": "text",
"id": "title",
"label": "Title",
"default": "Add-on Title"
},
{
"type": "text",
"id": "price",
"label": "Price Label",
"default": "Rp 50,000"
}
]
}
],
"presets": [
{
"name": "Main Personalize",
"blocks": [
{ "type": "addon_card", "settings": { "title": "Plush Doll", "price": "Rp 50,000" } },
{ "type": "addon_card", "settings": { "title": "Balloon", "price": "Rp 100,000" } },
{ "type": "addon_card", "settings": { "title": "Cake", "price": "Rp 300,000" } }
]
}
]
}
{% endschema %}