{% comment %}
  Main Product — "Product Detail Page Desktop" (Figma).
  Rebuild of src astro/components/sections/ProductDetails.astro (pixel-by-pixel):
    - Gallery (prev/next + dot pagination) + Description
    - Title / price / variant card + Delivery Information + sender fields
    - Add to Cart (Shopify form) & Check Out Now (WhatsApp)
    - "You May Also Like" + Care Instructions
{% endcomment %}
{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign cities_list = 'Jakarta Pusat|Jakarta Selatan|Jakarta Barat|Jakarta Timur|Jakarta Utara|Tangerang|Bekasi|Depok|Bogor' | split: '|'
  assign related = product.related_products
  if related.size == 0
    assign related = collections.all.products | reject: 'handle', product.handle
  endif
  assign flowers_fallback = 'product_details.flowers_fallback' | t
-%}

<section class="bg-[#FDF6F1]" data-product-title="{{ product.title }}" data-product-price="{{ product.price }}" data-wa-intro="{{ 'product_details.wa_intro' | t }}" data-wa-line="{{ 'product_details.wa_line' | t }}">
  <div class="mx-auto w-full max-w-[1440px] px-4 py-8 sm:px-6 lg:px-[70px] lg:py-12">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-14">
      {% comment %} Kiri: galeri + description {% endcomment %}
      <div data-gallery>
        <div class="relative aspect-[4/5] overflow-hidden rounded-lg bg-white">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 900 | image_tag: data-main-img: '', class: 'h-full w-full object-cover', loading: 'eager', alt: product.title | escape }}
          {% endif %}
          {% for media in product.media %}
            {% if media.media_type == 'image' and media != product.featured_media %}
              {{ media | image_url: width: 900 | image_tag: data-gallery-img: '', class: 'hidden', alt: product.title | escape }}
            {% endif %}
          {% endfor %}

          {% comment %} Panah prev/next {% endcomment %}
          <button type="button" data-nav="prev" aria-label="{{ 'product_details.photo_prev' | t }}" class="absolute left-4 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/80 text-[#3D3B2F] shadow-sm outline-none transition-colors hover:bg-white focus-visible:ring-2 focus-visible:ring-[#899B7A]">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="m10 4-4 4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" data-nav="next" aria-label="{{ 'product_details.photo_next' | t }}" class="absolute right-4 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/80 text-[#3D3B2F] shadow-sm outline-none transition-colors hover:bg-white focus-visible:ring-2 focus-visible:ring-[#899B7A]">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="m6 4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          {% comment %} Dot pagination {% endcomment %}
          <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-1.5">
            {% for media in product.media %}
              <button
                type="button"
                data-dot
                data-index="{{ forloop.index0 }}"
                aria-label="{{ 'product_details.view_photo' | t: index: forloop.index }}"
                class="h-1.5 rounded-full transition-all duration-200 {% if forloop.first %}is-active w-5 bg-[#3D3B2F]{% else %}w-1.5 bg-white/80{% endif %}"
              ></button>
            {% endfor %}
          </div>
        </div>

        {% comment %} Description {% endcomment %}
        <div class="mt-8">
          <h2 class="font-['Crimson_Text'] text-xl text-[#3D3B2F]">{{ 'product_details.description' | t }}</h2>
          <div class="mt-3 space-y-4 text-sm leading-relaxed text-[#6D6D6D]">
            {{ product.description }}
          </div>
        </div>
      </div>

      {% comment %} Kanan: title/price + delivery + CTA {% endcomment %}
      <div class="flex flex-col gap-5">
        {% comment %} Title & price card {% endcomment %}
        <div class="rounded-lg border border-[#CCC8A8] p-6 text-center shadow-[0_1px_3px_rgba(61,59,47,0.06)]">
          <h1 class="font-['Crimson_Text'] text-2xl text-[#3D3B2F]">{{ product.title }}</h1>
          <span class="mt-3 inline-block rounded-full border border-[#EAE8E8] px-4 py-1 text-xs text-[#3D3B2F]">{{ product.type | default: flowers_fallback }}</span>
          <p class="mt-3 font-['Crimson_Text'] text-xl text-[#3D3B2F]" data-product-price-display>
            {% if on_sale %}<span class="mr-1 text-[#B5B1AF] line-through">{{ product.compare_at_price | money }}</span>{% endif %}
            <span data-price-value>{{ product.price | money }}</span>
          </p>
          {% for option in product.options_with_values %}
            {% if option.name == 'Size' %}
              <p class="mt-1 text-[11px] uppercase tracking-[1.5px] text-[#6D6D6D]">{{ 'product_details.size_label' | t }}: {{ option.selected_value }}</p>
            {% endif %}
          {% endfor %}

          {% comment %} Varian material / option pills {% endcomment %}
          {% for option in product.options_with_values %}
            {% if option.name == 'Size' %}{% continue %}{% endif %}
            <div class="mt-4 flex items-start justify-center gap-5">
              {% assign option_field = 'option' | append: option.position %}
              {% for value in option.values %}
                {% assign swatch_variant = product.variants | where: option_field, value | first %}
                {% assign swatch_image = swatch_variant.featured_image | default: product.featured_image %}
                {% assign swatch_alt = value | escape %}
                <label class="group flex cursor-pointer flex-col items-center gap-1.5">
                  <input
                    type="radio"
                    name="option-{{ option.name | handle }}"
                    value="{{ value | escape }}"
                    data-option-input
                    data-option-name="{{ option.name | escape }}"
                    class="peer sr-only"
                    {% if option.selected_value == value %}checked{% endif %}
                  >
                  <span class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-full border border-transparent p-0.5 transition-colors duration-150 peer-checked:border-[#3D3B2F] peer-focus-visible:ring-2 peer-focus-visible:ring-[#899B7A] peer-focus-visible:ring-offset-2">
                    {% if swatch_image %}
                      {{ swatch_image | image_url: width: 80 | image_tag: class: 'h-full w-full rounded-full object-cover', alt: swatch_alt, loading: 'lazy' }}
                    {% else %}
                      <span class="flex h-full w-full items-center justify-center rounded-full bg-[#EAE8E8] text-[11px] font-bold text-[#3D3B2F]">{{ value }}</span>
                    {% endif %}
                  </span>
                  <span class="text-[11px] font-normal text-[#6D6D6D] transition-colors duration-150 peer-checked:font-semibold peer-checked:text-[#3D3B2F]">{{ value }}</span>
                </label>
              {% endfor %}
            </div>
          {% endfor %}
        </div>


        {% comment %} Delivery information {% endcomment %}
        <div class="rounded-lg border border-[#CCC8A8] p-5 shadow-[0_1px_3px_rgba(61,59,47,0.06)] sm:p-6">
          <h2 class="font-['Crimson_Text'] text-lg text-[#3D3B2F]">{{ 'product_details.delivery_information' | t }}</h2>

          <div class="mt-4 grid grid-cols-2 gap-3">
            <button type="button" data-delivery-tab data-tab="delivery" class="is-active flex items-center justify-center gap-2 rounded-lg border border-[#3D3B2F] py-2.5 text-xs font-semibold uppercase tracking-[0.5px]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7.5 12 3l9 4.5M3 7.5v9L12 21m-9-4.5L12 21m0-13.5 9 4.5M12 7.5v13.5m9-9v9L12 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {{ 'product_details.tab_delivery' | t }}
            </button>
            <button type="button" data-delivery-tab data-tab="pickup" class="flex items-center justify-center gap-2 rounded-lg border border-[#CCC8A8] py-2.5 text-xs font-semibold uppercase tracking-[0.5px] text-[#6D6D6D] transition-colors duration-150 hover:border-[#3D3B2F] hover:text-[#3D3B2F]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 21V6l8-3 8 3v15M4 21h16M9 21v-5h6v5M9 9h1m4 0h1M9 13h1m4 0h1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {{ 'product_details.tab_pickup' | t }}
            </button>
          </div>

          <div data-delivery-panel>
            <p class="mt-5 text-xs text-[#6D6D6D]">{{ 'product_details.delivery_city' | t }}</p>
            <div class="relative mt-2">
              <select class="w-full appearance-none rounded-lg border border-[#CCC8A8] px-3.5 py-2.5 pr-9 text-sm text-[#3D3B2F] outline-none transition-colors duration-150 focus:border-[#3D3B2F]">
                <option>{{ 'product_details.select_city' | t }}</option>
                {% for city in cities_list %}<option>{{ city }}</option>{% endfor %}
              </select>
              <svg class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#3D3B2F" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>

            <p class="mt-4 text-xs text-[#6D6D6D]">{{ 'product_details.detail_delivery' | t }}</p>
            <div class="mt-2 grid grid-cols-2 gap-4 rounded-lg border border-[#EAE8E8] bg-[#FAFAF2] p-4">
              <div>
                <p class="text-[11px] text-[#6D6D6D]">{{ 'product_details.receive_on' | t }}</p>
                <p class="mt-1 text-sm font-semibold text-[#3D3B2F]">05/29/2026</p>
              </div>
              <div>
                <p class="text-[11px] text-[#6D6D6D]">{{ 'product_details.send_to' | t }}</p>
                <p class="mt-1 truncate text-sm font-semibold text-[#3D3B2F]">Prosperity Tower, SCBD, Jakarta...</p>
              </div>
            </div>
            <p class="mt-3 text-xs italic leading-relaxed text-[#6D6D6D]">{{ 'product_details.delivery_note' | t }}</p>
          </div>

          {% comment %} Sender fields {% endcomment %}
          <div class="mt-5 space-y-3 border-t border-[#EAE8E8] pt-5">
            <div>
              <label for="sender-name" class="text-xs text-[#6D6D6D]">{{ 'product_details.sender_name' | t }}</label>
              <input id="sender-name" type="text" placeholder="{{ 'product_details.sender_name_placeholder' | t }}" class="mt-1.5 w-full rounded-lg border border-[#CCC8A8] px-3.5 py-2.5 text-sm text-[#3D3B2F] outline-none transition-colors duration-150 placeholder:text-[#A2A2A2] focus:border-[#3D3B2F]">
            </div>
            <div>
              <label for="sender-wa" class="text-xs text-[#6D6D6D]">{{ 'product_details.sender_wa' | t }}</label>
              <input id="sender-wa" type="text" placeholder="{{ 'product_details.sender_wa_placeholder' | t }}" class="mt-1.5 w-full rounded-lg border border-[#CCC8A8] px-3.5 py-2.5 text-sm text-[#3D3B2F] outline-none transition-colors duration-150 placeholder:text-[#A2A2A2] focus:border-[#3D3B2F]">
            </div>
            <div>
              <label for="sender-email" class="text-xs text-[#6D6D6D]">{{ 'product_details.sender_email' | t }}</label>
              <input id="sender-email" type="email" placeholder="{{ 'product_details.sender_email_placeholder' | t }}" class="mt-1.5 w-full rounded-lg border border-[#CCC8A8] px-3.5 py-2.5 text-sm text-[#3D3B2F] outline-none transition-colors duration-150 placeholder:text-[#A2A2A2] focus:border-[#3D3B2F]">
            </div>
          </div>
        </div>


        {% comment %} CTA {% endcomment %}
        <div class="flex flex-col gap-3">
          {% form 'product', product, class: 'flex flex-col gap-3' %}
            <select name="id" data-variant-select class="hidden">
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                  data-option1="{{ variant.option1 | escape }}"
                  data-option2="{{ variant.option2 | escape }}"
                  data-option3="{{ variant.option3 | escape }}"
                  data-price="{{ variant.price }}"
                >
                  {{ variant.title }} - {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
            <input type="hidden" name="quantity" value="1">
            <button type="submit" data-add-to-cart class="flex h-12 w-full items-center justify-center rounded-lg border border-[#3D3B2F] bg-white text-xs font-semibold uppercase tracking-[1px] text-[#3D3B2F] outline-none transition-colors duration-200 hover:bg-[#FDF6F1] focus-visible:ring-2 focus-visible:ring-[#899B7A] focus-visible:ring-offset-2">{{ 'product_details.add_to_cart' | t }}</button>
          {% endform %}
          <button type="button" data-checkout class="flex h-12 w-full items-center justify-center rounded-lg bg-[#BBCCBF] text-xs font-semibold uppercase tracking-[1px] text-white outline-none transition-colors duration-200 hover:bg-[#A8BCAE] focus-visible:ring-2 focus-visible:ring-[#3D3B2F] focus-visible:ring-offset-2">{{ 'product_details.checkout_now' | t }} · {{ product.price | money }}</button>
        </div>
      </div>
    </div>

    {% comment %} You may also like {% endcomment %}
    <section class="mt-20 lg:mt-28">
      <h2 class="text-center font-['Crimson_Text'] text-3xl text-[#3D3B2F]">{{ 'product_details.you_may_also_like' | t }}</h2>
      <div class="mt-10 grid grid-cols-1 gap-x-5 gap-y-12 sm:grid-cols-2 xl:grid-cols-4">
        {% for rp in collections['all'].products limit: 4 %}
          {% render 'product-card', product: rp %}
        {% endfor %}
      </div>
      <div class="mt-10 flex justify-center">
        <a href="{{ routes.all_products_collection_url }}" class="flex h-10 items-center justify-center rounded-full bg-[#BBCCBF] px-8 text-xs font-semibold uppercase tracking-[1px] text-white outline-none transition-colors duration-200 hover:bg-[#A8BCAE] focus-visible:ring-2 focus-visible:ring-[#3D3B2F] focus-visible:ring-offset-2">{{ 'product_details.view_all' | t }}</a>
      </div>
    </section>

    {% comment %} You may also like {% endcomment %}
    <section class="mt-20 lg:mt-28">
      <h2 class="text-center font-['Crimson_Text'] text-3xl text-[#3D3B2F]">{{ 'Add On Cute Extras to Your Bouquet!' }}</h2>
      <div class="mt-10 grid grid-cols-1 gap-x-5 gap-y-12 sm:grid-cols-2 xl:grid-cols-4">
        {% assign addon_count = 0 %}
        {% for product in collections['all'].products %}
          {% if product.category.name contains 'Add-on' or product.category.name contains 'Customization' %}
          {% if addon_count < 4 %}
            <div
              style="display: flex; flex-direction: column; justify-content: space-between; padding: 15px; border: 1px solid {{ card_border_color | default: '#E0E0E0' }}; border-radius: 8px; min-height: 382px; background: transparent; box-sizing: border-box;"
              {{ block.shopify_attributes }}>
              {%- comment -%} Gambar Produk {%- endcomment -%}
              <div
                style="width: 100%; aspect-ratio: 1/1; border-radius: 8px; overflow: hidden; background-color: #EBE8D8; margin-bottom: 16px;">
                {%- assign featured_img = product.featured_image | default: product.images.first -%}
                {% if featured_img != blank %}
                <img src="{{ featured_img | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover;">
                {% else %}
                <div
                  style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #8C886B; font-family: sans-serif;">
                  {{ product.title | default: 'Add-on' }}
                </div>
                {% endif %}
              </div>
      
              {%- comment -%} Detail Produk & Tombol {%- endcomment -%}
              <div style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%;">
                <div>
                  <h3
                    style="color: {{ title_font_color | default: '#1E2934' }}; font-family: 'Crimson Text', serif; font-size: 20px; font-weight: 400; margin: 0 0 4px 0;">
                    {{ product.title }}
                  </h3>
                  <span style="color: #1E2934; font-family: 'Open Sans', sans-serif; font-size: 16px;">
                    {{ product.price | money }}
                  </span>
                </div>
      
                {%- comment -%} Tombol Add to Cart / Select Variant {%- endcomment -%}
                {% assign current_variant = product.selected_or_first_available_variant %}
                <button type="button" class="js-add-addon-btn" data-variant-id="{{ current_variant.id }}" {% unless
                  product.available %}disabled{% endunless %}
                  style="width: 24px; height: 24px; border-radius: 50%; background-color: {% if product.available %}#CCC8A8{% else %}#E0E0E0{% endif %}; border: none; color: white; display: flex; align-items: center; justify-content: center; cursor: {% if product.available %}pointer{% else %}not-allowed{% endif %}; opacity: {% if product.available %}1{% else %}0.5{% endif %}; padding: 0;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 5v14m-7-7h14" />
                  </svg>
                </button>
              </div>
            </div>
          {% assign addon_count = addon_count | plus: 1 %}
          {% else %}
            {% break %} {% comment %} Hentikan loop jika sudah mencapai 3 produk {% endcomment %}
          {% endif %}
  
  
        {% endif %}
        {% endfor %}
      </div>
    </section>


    {% comment %} Care instructions {% endcomment %}
    <section class="mt-20 pb-8 lg:mt-28">
      <h2 class="text-center font-['Crimson_Text'] text-3xl text-[#3D3B2F]">{{ 'product_details.care_instructions' | t }}</h2>
      <div class="mt-10 grid grid-cols-1 border-l border-t border-[#CCC8A8] sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col items-center gap-3 border-b border-r border-[#CCC8A8] p-8 text-center">
          <svg width="28" height="28" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M25.0437 11.3166H22.9619V6.72827H25.0437V11.3166Z" fill="#3D3B2F"/><path d="M25.0437 41.2697H22.9619V36.6814H25.0437V41.2697Z" fill="#3D3B2F"/><path d="M41.2758 25.0433H36.6875V22.9551H41.2758V25.0433Z" fill="#3D3B2F"/><path d="M11.32 25.0433H6.72852V22.9551H11.32V25.0433Z" fill="#3D3B2F"/><path d="M23.9952 33.5534C21.5175 33.5534 19.1706 32.6178 17.3826 30.884C15.5434 29.1183 14.4993 26.7332 14.4514 24.182C14.3971 21.634 15.3455 19.2137 17.1112 17.3746C18.8801 15.5322 21.2589 14.4913 23.8068 14.4434C24.455 14.4306 25.1064 14.4785 25.7418 14.5967L25.3618 16.6498C24.8637 16.5635 24.356 16.5188 23.8515 16.5316C21.8591 16.5699 20.0008 17.3873 18.6151 18.821C17.2389 20.261 16.4949 22.1513 16.5364 24.1469C16.5779 26.1425 17.389 27.9976 18.8258 29.3801C20.2626 30.7659 22.1625 31.5003 24.1485 31.4652C26.1409 31.4268 28.0056 30.6094 29.385 29.1694C30.7707 27.7326 31.5083 25.8423 31.4732 23.8467C31.4221 21.6276 30.4067 19.5554 28.6666 18.1664L29.9757 16.538C32.1916 18.3197 33.5039 20.9667 33.5582 23.8084C33.6125 26.3596 32.6674 28.7767 30.8953 30.6158C29.1231 32.455 26.7444 33.4959 24.1932 33.5534H23.9952Z" fill="#3D3B2F"/><path d="M33.7105 15.7705L32.2354 14.2922L35.4826 11.0481L36.9578 12.5201L33.7105 15.7705Z" fill="#3D3B2F"/><path d="M12.5323 36.9487L11.0508 35.4736L14.3012 32.2263L15.7796 33.7015L12.5323 36.9487Z" fill="#3D3B2F"/><path d="M35.4826 36.9487L32.2354 33.7015L33.7105 32.2263L36.9578 35.4736L35.4826 36.9487Z" fill="#3D3B2F"/><path d="M14.3012 15.7705L11.0508 12.5201L12.5323 11.0481L15.7796 14.2922L14.3012 15.7705Z" fill="#3D3B2F"/><path d="M24.0016 2.08821C11.9226 2.08821 2.0914 11.9162 2.0914 23.9952C2.0914 36.0774 11.9226 45.9054 24.0016 45.9054C36.0806 45.9054 45.9118 36.0774 45.9118 23.9952C45.9118 11.9162 36.0806 2.08821 24.0016 2.08821ZM24.0016 47.9936C10.7667 47.9936 0 37.2301 0 23.9952C0 10.7699 10.7667 0 24.0016 0C37.2365 0 48 10.7699 48 23.9952C48 37.2301 37.2365 47.9936 24.0016 47.9936Z" fill="#3D3B2F"/><path d="M24.0021 16.55C19.896 16.55 16.5561 19.8899 16.5561 23.996C16.5561 28.099 19.896 31.4388 24.0021 31.4388C28.1083 31.4388 31.4481 28.099 31.4481 23.996C31.4481 19.8899 28.1083 16.55 24.0021 16.55ZM24.0021 33.6707C18.6635 33.6707 14.3242 29.3315 14.3242 23.996C14.3242 18.6574 18.6635 14.3181 24.0021 14.3181C29.3408 14.3181 33.68 18.6574 33.68 23.996C33.68 29.3315 29.3408 33.6707 24.0021 33.6707Z" fill="#3D3B2F"/></svg>
          <p class="text-sm font-semibold text-[#3D3B2F]">{{ 'product_details.care_1_title' | t }}</p>
          <p class="text-xs leading-relaxed text-[#6D6D6D]">{{ 'product_details.care_1_text' | t }}</p>
        </div>
        <div class="flex flex-col items-center gap-3 border-b border-r border-[#CCC8A8] p-8 text-center">
