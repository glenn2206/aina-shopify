{% comment %}
  Main Products — "Products Page Desktop" (Figma node 137:1467).
  Rebuild of src astro/components/sections/ProductsSection.astro (pixel-by-pixel).
  Filtering behaviour identical to the Astro prototype:
    - Category reads the product metafield (default custom.category, configurable)
    - For Occassions / Flowers read product tags
    - Sale = compare_at_price > price
    - Instant client-side filtering + sorting + pagination (9 per page)
{% endcomment %}
{%- liquid
  assign page_heading = section.settings.heading | default: collection.title
  assign occasion_key = section.settings.occasion_key | default: 'occasion'
  assign flowers_key = section.settings.flowers_key | default: 'plant-class'
  assign mo_field = section.settings.metaobject_field | default: 'name'
-%}

<section class="bg-[#FDF6F1]">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-[50px]">
    {% comment %} Heading + sort {% endcomment %}
    <div class="relative pt-10">
      <h1 class="text-center font-['Crimson_Text'] text-3xl font-normal text-[#1E2934] lg:text-[32px]">{{ page_heading }}</h1>

      <div class="mt-6 flex items-center justify-between gap-4 lg:absolute lg:right-0 lg:top-10 lg:mt-0">
        {% comment %} Filter (mobile) {% endcomment %}
        <button
          data-filter-toggle
          type="button"
          class="flex h-[29px] cursor-pointer items-center gap-2 rounded-full border border-[#EAE8E8] bg-transparent px-4 text-xs font-normal text-black lg:hidden"
        >
          {{ 'products_page.filter' | t }}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 3h8M4 6h4M5.5 9h1" stroke="#3D3B2F" stroke-width="1.2" stroke-linecap="round" />
          </svg>
        </button>

        {% comment %} Sorting dropdown {% endcomment %}
        <div class="relative">
          <button
            data-sort-toggle
            type="button"
            class="flex h-[29px] cursor-pointer items-center gap-2 rounded-full border border-[#EAE8E8] bg-transparent px-4 text-xs font-normal text-black"
          >
            <span data-sort-label>{{ 'products_page.sort_default' | t }}</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#3D3B2F" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div
            data-sort-menu
            class="absolute right-0 top-full z-20 mt-2 hidden w-56 rounded-lg border border-[#EAE8E8] bg-white p-1.5 shadow-[0_8px_24px_rgba(61,59,47,0.12)]"
          >
            <button data-sort="default" type="button" class="block w-full cursor-pointer rounded-md px-3 py-2 text-left text-xs text-[#3D3B2F] hover:bg-[#FDF6F1]">{{ 'products_page.sort_default' | t }}</button>
            <button data-sort="price-asc" type="button" class="block w-full cursor-pointer rounded-md px-3 py-2 text-left text-xs text-[#3D3B2F] hover:bg-[#FDF6F1]">{{ 'products_page.sort_price_asc' | t }}</button>
            <button data-sort="price-desc" type="button" class="block w-full cursor-pointer rounded-md px-3 py-2 text-left text-xs text-[#3D3B2F] hover:bg-[#FDF6F1]">{{ 'products_page.sort_price_desc' | t }}</button>
            <button data-sort="name" type="button" class="block w-full cursor-pointer rounded-md px-3 py-2 text-left text-xs text-[#3D3B2F] hover:bg-[#FDF6F1]">{{ 'products_page.sort_name' | t }}</button>
          </div>
        </div>

        <button type="button" aria-label="{{ 'products_page.grid_label' | t }}" class="flex h-6 w-6 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-[#3D3B2F]">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor" />
            <rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor" />
            <rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor" />
            <rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor" />
          </svg>
        </button>
      </div>
    </div>

    {% comment %} Sidebar + grid {% endcomment %}
    <div class="mt-8 flex flex-col gap-8 lg:mt-12 lg:flex-row lg:gap-5">
      {% comment %} Sidebar filter — options are generated from the products by JS {% endcomment %}
      <aside data-filter-panel class="hidden w-full shrink-0 flex-col lg:flex lg:w-[320px]">
        <a
          data-filter-all
          href="#"
          class="is-filter-active flex items-center gap-2 border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]"
        >
          {{ 'products_page.all_products' | t }}
        </a>
        <span class="mt-3 h-px w-full bg-[#CCC8A8]"></span>

        <a
          data-filter-sale
          href="#"
          class="mt-3 flex items-center gap-2 border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]"
        >
          {{ 'products_page.sale' | t }}
        </a>
        <span class="mt-3 h-px w-full bg-[#CCC8A8]"></span>

        {% comment %} Category — from product metafield {% endcomment %}
        <div class="mt-3" data-filter-group>
          <button
            type="button"
            data-filter-group-toggle
            aria-expanded="true"
            class="is-open flex w-full items-center justify-between border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]"
          >
            {{ 'products_page.category' | t }}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#D0D0D0" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <ul class="mt-2 flex flex-col" data-category-list></ul>
        </div>
        <span class="mt-2 h-px w-full bg-[#CCC8A8]"></span>

        {% comment %} For Occassions — from product tags {% endcomment %}
        <div class="mt-3" data-filter-group>
          <button
            type="button"
            data-filter-group-toggle
            aria-expanded="true"
            class="is-open flex w-full items-center justify-between border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]"
          >
            {{ 'products_page.for_occasions' | t }}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#D0D0D0" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <ul class="mt-2 flex flex-col" data-occasion-list></ul>
        </div>
        <span class="mt-2 h-px w-full bg-[#CCC8A8]"></span>

        {% comment %} Flowers — from product tags {% endcomment %}
        <div class="mt-3" data-filter-group>
          <button
            type="button"
            data-filter-group-toggle
            aria-expanded="true"
            class="is-open flex w-full items-center justify-between border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]"
          >
            {{ 'products_page.flowers' | t }}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#D0D0D0" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <ul class="mt-2 flex flex-col" data-flower-list></ul>
        </div>
      </aside>


      {% comment %} Grid produk (semua produk dirender, filter client-side) {% endcomment %}
      <div class="flex-1">
        <div data-product-grid class="grid grid-cols-1 gap-x-5 gap-y-12 sm:grid-cols-2 xl:grid-cols-3">
          {% for product in collection.products %}
            {%- liquid
              assign on_sale = false
              if product.compare_at_price > product.price
                assign on_sale = true
              endif
              assign product_category = product.category.name | default: product.type
            -%}

            {%- comment %}
              occasion/plant-class metafields are metaobject_reference LISTS.
              .value returns an array of metaobjects → we extract a text label
              from each object (configured field, fallback name/title) so the
              client-side filter can match simple strings.
            {%- endcomment -%}
            {%- capture occasion_labels -%}
              {%- assign occasion_items = product.metafields.shopify[occasion_key].value -%}
              {%- for mo in occasion_items -%}
                {%- liquid
                  # 1. Cek langsung properti standar Metaobject Taxonomy (.label atau .name)
                  assign label = mo.label | default: mo.name | default: mo.title

                  # 2. Jika mo_field spesifik diisi (misal: 'display_name'), ambil dari mo[mo_field]
                  if label == blank and mo_field != blank
                    assign label = mo[mo_field].value | default: mo[mo_field]
                  endif

                  # 3. Fallback jika nilainya masih bertipe Plain String (bukan metaobject)
                  if label == blank and mo.first == nil
                    assign label = mo
                  endif
                -%}
                {%- if label != blank -%}
                  {{ label | strip }}{% unless forloop.last %},{% endunless %}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- capture flowers_labels -%}
              {%- assign flower_items = product.metafields.shopify[flowers_key].value -%}
              {%- for mo in flower_items -%}
                {%- liquid
                  # 1. Cek langsung properti label/name standar Shopify Taxonomy Metaobject
                  assign label = mo.label | default: mo.name | default: mo.title

                  # 2. Jika mo_field spesifik diisi, ambil dari mo[mo_field]
                  if label == blank and mo_field != blank
                    assign label = mo[mo_field].value | default: mo[mo_field]
                  endif

                  # 3. Fallback jika nilainya berupa Plain String biasa
                  if label == blank and mo.first == nil
                    assign label = mo
                  endif
                -%}
                {%- if label != blank -%}
                  {{ label | strip }}{% unless forloop.last %},{% endunless %}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            <div
              data-product-card
              data-category="{{ product_category }}"
              data-occasions="{{ occasion_labels }}"
              data-flowers="{{ flowers_labels }}"
              data-sale="{{ on_sale }}"
              data-price="{{ product.price }}"
              data-title="{{ product.title | escape }}"
            >
              {% render 'product-card', product: product, category_label: product_category %}
            </div>
          {% endfor %}
        </div>

        <p data-result-count data-i18n-showing="{{ 'products_page.showing_html' | t }}" class="mt-10 text-center text-xs tracking-wide text-[#6D6D6D]"></p>

        {% comment %} Pagination (diisi oleh JS) {% endcomment %}
        <div data-pagination class="relative mt-10 pb-8"></div>
      </div>
    </div>

    {% comment %} WhatsApp float {% endcomment %}
    <a
      href="https://wa.me/"
      target="_blank"
      rel="noopener"
      aria-label="{{ 'products_page.whatsapp_label' | t }}"
      class="fixed bottom-6 right-6 z-40 flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-[0_8px_24px_rgba(0,0,0,0.18)] transition-transform duration-200 hover:scale-105"
    >
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.8-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"
          fill="#22CE5A"
        />
      </svg>
    </a>
  </div>
</section>


<script>
  (() => {
    const cards = Array.from(document.querySelectorAll('[data-product-card]'));
    const grid = document.querySelector('[data-product-grid]');
    const pagination = document.querySelector('[data-pagination]');
    const resultCount = document.querySelector('[data-result-count]');
    const sortToggle = document.querySelector('[data-sort-toggle]');
    const sortMenu = document.querySelector('[data-sort-menu]');
    const sortLabel = document.querySelector('[data-sort-label]');

    const PAGE_SIZE = 9;
    const state = { category: null, occasion: null, flower: null, sale: false, sort: 'default', page: 1 };

    const escapeHtml = (str) =>
      String(str).replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));

    const split = (val) => String(val || '').split(',').map((s) => s.trim()).filter(Boolean);

    // ---- Build sidebar option lists from the rendered products ----
    const buildOptions = (container, getValues, activeKey, dotClass) => {
      const set = new Set();
      cards.forEach((c) => getValues(c).forEach((v) => v && set.add(v)));
      const values = [...set].sort((a, b) => a.localeCompare(b));
      const group = container.closest('[data-filter-group]');
      if (!values.length) {
        if (group) group.classList.add('hidden');
        return;
      }
      values.forEach((v) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.filter = v;
        btn.dataset.filterKey = activeKey;
        // The active-state stylesheets target [data-filter-category|occasion|flower],
        // so expose the matching attribute (refreshFilterUI toggles .is-filter-active).
        btn.dataset[`filter${activeKey[0].toUpperCase()}${activeKey.slice(1)}`] = activeKey;
        btn.className = 'flex w-full items-center gap-2 px-2 py-[3px] text-left text-base tracking-[-0.8px] text-[#6D6D6D]';
        btn.innerHTML = `<span class="${dotClass}">•</span><span class="py-[3px]">${escapeHtml(v)}</span>`;
        btn.addEventListener('click', () => {
          state[activeKey] = state[activeKey] === v ? null : v;
          state.page = 1;
          render(true);
        });
        container.appendChild(btn);
      });
    };

    const categoryList = document.querySelector('[data-category-list]');
    if (categoryList) buildOptions(categoryList, (c) => split(c.dataset.category), 'category', 'text-[#3D3B2F]');

    const occasionList = document.querySelector('[data-occasion-list]');
    if (occasionList) buildOptions(occasionList, (c) => split(c.dataset.occasions), 'occasion', 'text-[#7E4C4C]');

    const flowerList = document.querySelector('[data-flower-list]');
    if (flowerList) buildOptions(flowerList, (c) => split(c.dataset.flowers), 'flower', 'text-[#7E4C4C]');

    // Deep-link support: ?occasion=Graduation (also &category=, &flower=) pre-applies
    // a filter on load — used by the Occasions page and the homepage teaser tiles,
    // so those links actually filter real products instead of just landing here.
    const applyParamFilters = () => {
      const params = new URLSearchParams(window.location.search);
      const findValue = (list, want) => {
        if (!want) return null;
        const target = want.trim().toLowerCase();
        return list.find((v) => v.toLowerCase() === target) || null;
      };
      const allOccasions = [...new Set(cards.flatMap((c) => split(c.dataset.occasions)))];
      const allCategories = [...new Set(cards.flatMap((c) => split(c.dataset.category)))];
      const allFlowers = [...new Set(cards.flatMap((c) => split(c.dataset.flowers)))];

      const wantOccasion = findValue(allOccasions, params.get('occasion'));
      const wantCategory = findValue(allCategories, params.get('category'));
      const wantFlower = findValue(allFlowers, params.get('flower'));

      if (wantOccasion) state.occasion = wantOccasion;
      if (wantCategory) state.category = wantCategory;
      if (wantFlower) state.flower = wantFlower;

      if (wantOccasion || wantCategory || wantFlower) {
        document.querySelector('[data-filter-panel]')?.classList.remove('hidden');
      }
    };
    applyParamFilters();

    // ---- Filtering / sorting / pagination (mirrors ProductsSection.astro) ----
    const matches = (card) => {
      if (state.sale && card.dataset.sale !== 'true') return false;
      if (state.category && card.dataset.category !== state.category) return false;
      if (state.occasion && !split(card.dataset.occasions).includes(state.occasion)) return false;
      if (state.flower && !split(card.dataset.flowers).includes(state.flower)) return false;
      return true;
    };

    const sorted = (list) => {
      const arr = [...list];
      if (state.sort === 'price-asc') arr.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
      else if (state.sort === 'price-desc') arr.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
      else if (state.sort === 'name') arr.sort((a, b) => (a.dataset.title || '').localeCompare(b.dataset.title || ''));
      return arr;
    };


    const refreshFilterUI = () => {
      document.querySelectorAll('[data-filter-all]').forEach((el) =>
        el.classList.toggle('is-filter-active', !state.sale && !state.category && !state.occasion && !state.flower)
      );
      document.querySelectorAll('[data-filter-sale]').forEach((el) => el.classList.toggle('is-filter-active', state.sale));
      document.querySelectorAll('[data-filter-group] button[data-filter]').forEach((el) =>
        el.classList.toggle('is-filter-active', el.dataset.filter === state[el.dataset.filterKey])
      );
    };

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const isVisible = (card) => !card.classList.contains('hidden');

    const renderPagination = (pages) => {
      if (!pagination) return;
      if (pages <= 1) {
        pagination.innerHTML = '';
        return;
      }
      let html = '<div class="flex items-center justify-center gap-5 text-[10px] font-normal text-[#6D6D6D]/50">';
      for (let i = 1; i <= pages; i++) {
        if (i === state.page) {
          html += `<span class="relative font-bold text-[#3D3B2F]">${i}<span class="absolute -bottom-1 left-1/2 h-[2px] w-5 -translate-x-1/2 bg-[#3D3B2F]"></span></span>`;
        } else {
          html += `<button type="button" data-page="${i}" class="cursor-pointer transition-colors hover:text-[#3D3B2F]">${i}</button>`;
        }
      }
      html += '</div><span class="absolute -bottom-0.5 left-0 h-px w-full bg-[#CCC8A8]"></span>';
      pagination.innerHTML = html;
    };

    let renderToken = 0;
    const render = (animate = false) => {
      const filtered = cards.filter(matches);
      const list = sorted(filtered);
      const pages = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
      if (state.page > pages) state.page = pages;
      const start = (state.page - 1) * PAGE_SIZE;
      const slice = list.slice(start, start + PAGE_SIZE);

      const prevVisible = cards.filter(isVisible);

      // Applies the new filtered/sorted state + updates counters & pagination
      const apply = () => {
        // Reorder the DOM so sorting is visually applied (moves visible cards in order)
        if (grid) slice.forEach((c) => grid.appendChild(c));
        cards.forEach((c) => c.classList.toggle('hidden', !slice.includes(c)));
        refreshFilterUI();

        if (resultCount) {
          const template = resultCount.dataset.i18nShowing || 'Showing {shown} of {total} products';
          resultCount.textContent = template.replace('{shown}', list.length).replace('{total}', cards.length);
          resultCount.classList.remove('is-updated');
          void resultCount.offsetWidth; // reflow → re-trigger the animation
          resultCount.classList.add('is-updated');
        }
        renderPagination(pages);
      };

      // First paint or reduced-motion users → plain swap, no animation
      if (!animate || prefersReducedMotion) {
        cards.forEach((c) => c.classList.remove('is-leaving', 'is-entering'));
        apply();
        return;
      }

      const token = ++renderToken;

      // Fade out cards leaving the viewport (filtered out / moved to another page)
      cards.forEach((c) => c.classList.remove('is-leaving'));
      const leaving = prevVisible.filter((c) => !slice.includes(c));
      leaving.forEach((c) => c.classList.add('is-leaving'));

      // Cards entering the viewport get a staggered rise-in.
      // A pure reorder (e.g. sorting) re-runs the cascade over the whole grid.
      let entering = slice.filter((c) => !prevVisible.includes(c));
      if (!leaving.length && !entering.length) entering = slice;

      window.setTimeout(() => {
        if (token !== renderToken) return; // a newer render superseded this one
        apply();
        entering.forEach((card, i) => {
          card.classList.remove('is-entering');
          void card.offsetWidth; // reflow → re-trigger on rapid re-renders
          card.style.setProperty('--enter-delay', `${Math.min(i * 70, 490)}ms`);
          card.classList.add('is-entering');
        });
      }, 240);
    };

    // All Products → reset semua filter
    document.querySelectorAll('[data-filter-all]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.preventDefault();
        state.category = null;
        state.occasion = null;
        state.flower = null;
        state.sale = false;
        state.page = 1;
        render(true);
      })
    );

    // Sale → toggle
    document.querySelectorAll('[data-filter-sale]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.preventDefault();
        state.sale = !state.sale;
        state.page = 1;
        render(true);
      })
    );

    // Pagination (delegasi)
    pagination?.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-page]');
      if (!btn) return;
      state.page = Number(btn.dataset.page);
      render(true);
    });

    // Sorting
    sortToggle?.addEventListener('click', () => sortMenu?.classList.toggle('hidden'));
    document.querySelectorAll('[data-sort]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.sort = btn.dataset.sort;
        state.page = 1;
        if (sortLabel) sortLabel.textContent = btn.textContent.trim();
        sortMenu?.classList.add('hidden');
        render(true);
      });
    });
    document.addEventListener('click', (e) => {
      if (sortMenu && !e.target.closest('[data-sort-toggle]') && !e.target.closest('[data-sort-menu]')) {
        sortMenu.classList.add('hidden');
      }
    });

    // Filter panel mobile toggle
    document.querySelector('[data-filter-toggle]')?.addEventListener('click', () => {
      document.querySelector('[data-filter-panel]')?.classList.toggle('hidden');
    });

    // Filter group accordions (Category / For Occassions / Flowers)
    document.querySelectorAll('[data-filter-group-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const list = btn.parentElement?.querySelector('ul');
        const open = btn.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
        if (list) list.classList.toggle('hidden', !open);
      });
    });

    render();
  })();
</script>


