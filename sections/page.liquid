{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  ANIA: When a page has the handle "about", we render the migrated ANIA
  "About Us Ver 2" design automatically (snippets/about-page.liquid). This way
  the About page shows the new design even when the default "page" template is
  assigned — no manual template assignment needed in the admin. Same for the
  handle "occasions" (snippets/occasions-page.liquid) — the standalone
  destination for the "For Occasions" nav link. Same for handle "components"
  (snippets/lib-showcase-content.liquid) — internal dev reference page.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

{% if page.handle == 'about' %}
  {% render 'about-page' %}
{% elsif page.handle == 'occasions' %}
  {% render 'occasions-page' %}
{% elsif page.handle == 'terms-and-condition' %}
  {% render 'terms-and-condition-page' %}
{% elsif page.handle == 'components' %}
  {% render 'lib-showcase-content' %}
{% else %}
  <h1>{{ page.title }}</h1>

  {{ page.content }}
{% endif %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
