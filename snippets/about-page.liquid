{% comment %} AboutGallery — collage {% endcomment %}
<section class="bg-[#FDF6F1] pb-[120px] lg:pb-[160px]">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-[70px]">
