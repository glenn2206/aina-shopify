      <img src="{{ 'about-collage-3.png' | asset_url }}" alt="{{ 'about_page.collage_alt_1' | t }}" width="1140" height="1426" class="relative z-10 w-full max-w-[570px] object-cover" loading="lazy" style="height: 700px">

      <div class="relative z-10 flex w-full max-w-[469px] flex-col gap-[19px] overflow-hidden items-center justify-center"  style="height: 700px">
        <img src="{{ 'about-collage-1.png' | asset_url }}" alt="{{ 'about_page.collage_alt_2' | t }}" width="938" height="700" class="w-full object-cover" loading="lazy">
        <img src="{{ 'about-collage-2.png' | asset_url }}" alt="{{ 'about_page.collage_alt_3' | t }}" width="928" height="692" class=" w-full object-cover" loading="lazy">
      </div>
    </div>
  </div>
</section>

{% comment %} SocialStory — "A Flower for every Story" {% endcomment %}
<section style="background-color: #F6EBE3;-webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%); mask-image: linear-gradient(to right, black 85%, transparent 100%);">
