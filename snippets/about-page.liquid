{% comment %}
  ANIA "About Us Ver 2" design markup, migrated from src astro:
  AboutHero, ModernApproach, BehindFlower, AboutGallery, SocialStory.
  Rendered by sections/main-about.liquid (template page.about) and
  automatically by sections/page.liquid when page.handle == 'about'.
{% endcomment %}

{% comment %} AboutHero — 480/960 split, image right {% endcomment %}
<section class="w-full overflow-hidden" style="background-color: #F6EBE3;">
  <!-- 50/50 Grid Layout (grid-cols-1 on mobile, grid-cols-2 on large screens) -->
  <div class="grid w-full grid-cols-1 items-stretch lg:grid-cols-2">
    <!-- Image Column (50% Width / Order first on left) -->
    <div class="relative h-[320px] lg:h-auto lg:order-first">
      <img src="{{ 'about-hero.jpg' | asset_url }}" alt="{{ 'about_page.hero_img_alt' | t }}" width="960" height="506" class="absolute inset-0 h-full w-full object-cover" loading="eager">
    </div>

    <!-- Content Column (50% Width / On right) -->
    <div class="flex flex-col justify-center px-5 py-16 sm:px-10 lg:px-[70px] lg:py-16">
      <!-- Subheader -->
      <span class="text-[14px] font-[Open_Sans] uppercase text-[#3D3B2F] tracking-[4px] font-semibold">{{ 'about_page.hero_subheading' | t | default: "Who We Are?" }}</span>

      <!-- Main Heading -->
      <h1 class="mt-2 font-['Cormorant_Garamond'] text-[60px] font-normal leading-[1.2] text-[#1E2934] lg:text-[40px]">{{ 'about_page.hero_heading' | t | default: "Flowers That Speak Louder Than Words" }}</h1>

      <!-- Body Paragraph 1 -->
      <p class="mt-6 text-[16px] font-[Open_Sans] leading-[1.65] text-[#3D3B2F]"  style="font-size:16px;">{{ 'about_page.hero_body' | t }}</p>

      <!-- Quote Callout -->
      <p class="mt-6 font-['Crimson_Text'] text-[#1E2934]" style="font-size:24px; font-weight:400;">
        “{{ 'about_page.hero_quote' | t | default: "Flowers are the earth’s way of smiling." }}”
      </p>

      <!-- Body Paragraph 2 -->
      <p class="font-[Open_Sans] leading-[1.65] text-[#3D3B2F]" style="font-size:16px;">{{ 'about_page.hero_body_secondary' | t }}</p>

      <!-- Our Promise Section -->
      <div class="mt-8 pt-6">
        <h2 class="font-['Crimson_Text'] text-[#1E2934]" style="font-size:32px;">{{ 'about_page.promise_heading' | t | default: "Our Promise" }}</h2>
        <p class="font-[Open_Sans] leading-[1.65] text-[#3D3B2F]" style="font-size:16px;">{{ 'about_page.promise_body' | t }}</p>

        <!-- Checkmark List -->
        <ul class="mt-2 space-y-2 text-sm text-[#3D3B2F]">
          <li class="flex items-center gap-2">
            <span class="font-[Open_Sans] font-bold" style="font-size:16px;">✓</span> {{ 'about_page.promise_item_1' | t | default: "High Quality Gift and Flower Arrangement" }}
          </li>
          <li class="flex items-center gap-2">
            <span class="font-[Open_Sans] font-bold" style="font-size:16px;">✓</span> {{ 'about_page.promise_item_2' | t | default: "Professionally arranged for 10+ years" }}
          </li>
          <li class="flex items-center gap-2">
            <span class="font-[Open_Sans] font-bold" style="font-size:16px;">✓</span> {{ 'about_page.promise_item_3' | t | default: "Easy online ordering system" }}
          </li>
          <li class="flex items-center gap-2">
            <span class="font-[Open_Sans] font-bold" style="font-size:16px;">✓</span> {{ 'about_page.promise_item_4' | t | default: "Reliable on-time delivery" }}
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

