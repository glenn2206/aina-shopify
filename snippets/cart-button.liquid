{% comment %}
  CartButton — cart icon with count badge.
  Rebuild of src astro/components/CartButton.astro (pixel-by-pixel).
  Params: tone = 'light' | 'dark'  (default 'dark')
{% endcomment %}
{%- liquid
  assign icon_color = '#3d3b2f'
  assign badge_border = '#3d3b2f'
  if tone == 'light'
    assign icon_color = '#CCC8A8'
    assign badge_border = '#CCC8A8'
  endif
-%}
<a
  href="{{ routes.cart_url }}"
  data-cart-button
  data-initial-count="{{ cart.item_count }}"
  class="relative inline-flex shrink-0 cursor-pointer items-center justify-center border-0 bg-transparent p-0 transition-opacity duration-200 hover:opacity-75"
  style="width:24px;height:24px;color:var(--nav-cart, {{ icon_color }})"
  aria-label="Cart"
>
  <svg
    data-cart-icon
    class="h-full w-full transition-transform duration-100 ease-in-out"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2zM8.1 13h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63z"
    />
  </svg>
  <span
    data-cart-badge
    class="absolute flex h-[9px] min-w-[9px] items-center justify-center rounded-full border-[0.5px] bg-[#fdf6f1] px-[1px] font-['Open_Sans'] text-[6px] font-semibold leading-none opacity-0 transition-transform duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
    style="top:0.3px; right:1.3px; border-color:var(--nav-cart, {{ badge_border }}); color:#3d3b2f"
    aria-hidden="true"
  ></span>
</a>

<script>
  // Sync badge across all CartButton instances on the page (from CartButton.astro).
  (() => {
    const buttons = [...document.querySelectorAll('[data-cart-button]')];

    const shake = (el) => {
      if (!el) return;
      const steps = ['rotate(-8deg)', 'rotate(8deg)', 'rotate(-5deg)', 'rotate(3deg)', 'rotate(0deg)'];
      el.style.transition = 'transform 0.06s ease-in-out';
      steps.forEach((t, i) => {
        setTimeout(() => {
          el.style.transform = t;
          if (i === steps.length - 1) el.style.transition = '';
        }, i * 60);
      });
    };

    const render = (btn, count, animate) => {
      const badge = btn.querySelector('[data-cart-badge]');
      const icon = btn.querySelector('[data-cart-icon]');
      if (!badge) return;
      btn.dataset.count = String(count);
      if (count <= 0) {
        badge.textContent = '';
        badge.style.opacity = '0';
        return;
      }
      badge.textContent = count > 99 ? '99+' : String(count);
      badge.style.transition = 'none';
      badge.style.transform = animate ? 'scale(0)' : 'scale(1)';
      badge.style.opacity = '1';
      void badge.offsetWidth;
      badge.style.transition = '';
      badge.style.transform = 'scale(1)';
      if (animate) shake(icon);
    };

    buttons.forEach((btn) => {
      const init = parseInt(btn.dataset.initialCount || '0', 10);
      render(btn, init, false);
    });

    document.addEventListener('ania:addtocart', (e) => {
      const amount = e.detail && typeof e.detail.amount === 'number' ? e.detail.amount : 1;
      buttons.forEach((btn) => {
        const current = parseInt(btn.dataset.count || '0', 10);
        render(btn, current + amount, true);
      });
    });

    // Absolute sync — used by the cart page after a live quantity/remove update.
    document.addEventListener('ania:cartcount', (e) => {
      const count = e.detail && typeof e.detail.count === 'number' ? e.detail.count : null;
      if (count === null) return;
      buttons.forEach((btn) => render(btn, count, false));
    });
  })();
</script>
