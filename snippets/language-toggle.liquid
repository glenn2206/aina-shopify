{% comment %}
  LanguageToggle — ENG/IND glass pill switcher.
  Uses robust URL path construction to handle both root and sub-pages like /pages/xxx properly.
{% endcomment %}

{%- liquid
  assign current_iso = localization.language.iso_code | downcase
  
  assign current_lang = 'en'
  if current_iso contains 'id'
    assign current_lang = 'id'
  endif

  assign en_lang = nil
  assign id_lang = nil
  assign published_count = 0

  for language in localization.available_languages
    assign published_count = published_count | plus: 1
    assign lang_iso = language.iso_code | downcase
    
    if lang_iso contains 'en'
      assign en_lang = language
    elsif lang_iso contains 'id'
      assign id_lang = language
    endif
  endfor

  # 1. Strip active locale prefix to isolate the raw path (e.g. "/pages/about")
  assign raw_path = request.path
  if localization.language.root_url != '/'
    assign raw_path = raw_path | remove_first: localization.language.root_url
  endif

  # Ensure path starts with a single slash using standard Liquid slice filter
  assign first_char = raw_path | slice: 0, 1
  if first_char != '/'
    assign raw_path = '/' | append: raw_path
  endif

  # 2. Build explicit target URLs
  # English target path
  assign en_root = en_lang.root_url
  if en_root == '/'
    assign en_url = raw_path
  else
    assign en_url = en_root | append: raw_path | replace: '//', '/'
  endif

  # Indonesian target path
  assign id_root = id_lang.root_url
  if id_root == '/'
    assign id_url = raw_path
  else
    assign id_url = id_root | append: raw_path | replace: '//', '/'
  endif

  # Pill alignment offsets
  if current_lang == 'id'
    assign pill_x = '42px'
    assign pill_w = '38px'
  else
    assign pill_x = '0px'
    assign pill_w = '41px'
  endif
-%}

{%- if published_count > 1 and en_lang != nil and id_lang != nil -%}
<div
  data-lang-toggle
  data-lang="{{ current_lang }}"
  class="relative flex select-none items-center gap-px overflow-hidden rounded-[49.5px] bg-[rgba(171,171,171,0.25)] p-[2px] backdrop-blur-[5px] shadow-[inset_-0.5px_-0.5px_0.5px_#ffffff40,inset_0.5px_0.5px_0.5px_#ffffff80,inset_-0.5px_-0.5px_0px_#ffffff33] transition-transform duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] active:scale-[0.97]"
  style="--pill-x: {{ pill_x }}; --pill-w: {{ pill_w }};"
  role="group"
  aria-label="Pilih bahasa / Choose language"
>
  {% if current_lang == 'en' %}
    <span
      class="relative z-[2] flex h-6 w-[41px] cursor-pointer items-center justify-center border-0 bg-transparent p-0 font-['Open_Sans'] text-[12px] font-normal leading-4 text-[#3d3b2f]"
      aria-current="true"
      data-lang-opt="en"
    >ENG</span>
  {% else %}
    <a
      href="{{ en_url }}"
      class="relative z-[2] flex h-6 w-[41px] cursor-pointer items-center justify-center border-0 bg-transparent p-0 font-['Open_Sans'] text-[12px] font-normal leading-4 text-[rgba(124,124,124,0.5)] transition-colors duration-[400ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-[#3d3b2f] focus-visible:rounded-[49.5px] focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-1 focus-visible:outline-[rgba(61,59,47,0.6)]"
      aria-label="English"
      data-lang-opt="en"
    >ENG</a>
  {% endif %}

  {% if current_lang == 'id' %}
    <span
      class="relative z-[2] flex h-6 w-[38px] cursor-pointer items-center justify-center border-0 bg-transparent p-0 font-['Open_Sans'] text-[12px] font-normal leading-4 text-[#3d3b2f]"
      aria-current="true"
      data-lang-opt="id"
    >IND</span>
  {% else %}
    <a
      href="{{ id_url }}"
      class="relative z-[2] flex h-6 w-[38px] cursor-pointer items-center justify-center border-0 bg-transparent p-0 font-['Open_Sans'] text-[12px] font-normal leading-4 text-[rgba(124,124,124,0.5)] transition-colors duration-[400ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-[#3d3b2f] focus-visible:rounded-[49.5px] focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-1 focus-visible:outline-[rgba(61,59,47,0.6)]"
      aria-label="Bahasa Indonesia"
      data-lang-opt="id"
    >IND</a>
  {% endif %}

  <span
    class="lang-pill pointer-events-none absolute left-[2px] top-[2px] z-[1] h-6 w-[var(--pill-w,41px)] rounded-[49.5px] bg-[#fdf6f1] translate-x-[var(--pill-x,0px)] transition-[transform,translate,width] duration-[400ms] ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform"
    aria-hidden="true"
  ></span>
</div>
{%- endif -%}