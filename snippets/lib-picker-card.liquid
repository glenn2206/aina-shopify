{% comment %}
  [Component Library] Picker Card snippet (Occasions / Category / Flower teaser)
  Params:
    href          — url tujuan (required)
    image_src     — url gambar (required)
    alt           — alt text (optional)
    label         — teks label (required)
    highlighted   — true/false, pakai style hijau solid (optional)
  Usage:
    {% render 'lib-picker-card', href: graduation_href, image_src: graduation_img, label: 'Graduation', highlighted: true %}
{% endcomment %}
<a href="{{ href }}" class="picker-card">
  <img src="{{ image_src }}" alt="{{ alt | default: label }}" loading="lazy">
  <span class="picker-card__label{% if highlighted %} picker-card__label--highlighted{% endif %}">
    {{ label }}
    <span class="picker-card__chevron" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </span>
</a>
