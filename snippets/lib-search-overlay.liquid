{% comment %}
  [Component Library] Search Overlay snippet
  Markup + toggle-nya generic (dihandle lib-components.js → initSearchOverlay),
  tapi HASIL pencarian di Shopify ada 2 jalur — pilih salah satu:

  A) Live/AJAX (predictive search) — direkomendasikan, sesuai referensi
     (hasil muncul saat mengetik tanpa reload). Fetch ke:
       /search/suggest.json?q={query}&resources[type]=product&resources[limit]=8
     lalu render kartu produk dari JSON itu ke [data-search-grid] via JS
     tambahan (di luar scope initSearchOverlay bawaan, yang hanya filter
     kartu STATIS lewat data-tags — ganti dengan fetch kalau butuh live data).

  B) Submit ke halaman hasil pencarian bawaan Shopify (routes.search_url),
     lalu di sections/search.liquid render {% render 'lib-product-card', product: product %}
     untuk setiap item di 'search.results', dengan hitung 'search.results_count'
     buat teks "X RESULTS" dan tampilkan .search-overlay__empty kalau
     search.results_count == 0.

  Snippet ini menyediakan MARKUP-nya saja (bar + form submit ke jalur B by
  default); untuk jalur A tinggal cegah default submit & fetch manual.

  Usage:
    {% render 'lib-search-overlay' %}
{% endcomment %}
<div class="search-overlay" data-search-panel hidden>
  <form class="search-overlay__bar" action="{{ routes.search_url }}" method="get" role="search">
    <span class="search-overlay__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="7.75" cy="7.75" r="5.5" stroke="currentColor" stroke-width="1.5"/><line x1="11.8" y1="11.8" x2="16" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </span>
    <input type="search" name="q" class="search-overlay__input" placeholder="Search..." data-search-input autocomplete="off">
    <input type="hidden" name="type" value="product">
    <button type="button" class="search-overlay__close" data-search-close aria-label="Close search">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 1l10 10M11 1 1 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
    </button>
  </form>

  {% comment %} Hasil — otomatis terisi kalau snippet ini dirender di halaman search (search.performed true) {% endcomment %}
  {% if search.performed %}
    <div class="search-overlay__results" data-search-results>
      <p class="search-overlay__count" data-search-count>{{ search.results_count }} RESULTS</p>
      <div class="search-overlay__divider"></div>

      {% if search.results_count > 0 %}
        <div class="grid grid--4" data-search-grid>
          {% for item in search.results limit: 8 %}
            {% render 'lib-product-card', product: item %}
          {% endfor %}
        </div>
      {% else %}
        <p class="search-overlay__empty" data-search-empty>No results could be found</p>
      {% endif %}

      <div class="search-overlay__cta">
        {% render 'lib-button', href: routes.all_products_collection_url, label: 'View All Product', variant: 'primary' %}
      </div>
    </div>
  {% endif %}
</div>
