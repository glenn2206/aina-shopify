{% comment %}
  OccasionsPage — standalone "For Occasions" destination (Figma).

  Rendered automatically for the Shopify Page with handle "occasions" (see
  sections/page.liquid) — no admin template assignment required — and also
  available as its own section (main-occasions-page.liquid) for manual
  template assignment.

  Sections:
    1. Hero — "What's the Occasion?" + Shop Flowers / Custom Order CTAs.
    2. "What Do You Want to Say?" — 5 occasion rows, each pulling real
       products via snippets/occasion-row.liquid (paginated 3 at a time).
    3. "Who Are You Sending Flowers To?" — recipient guide grid.

  NOTE: the hero currently reuses an existing product photo (hero-2.png) as
  a placeholder for the bride/bouquet photo in the Figma design — swap
  section below once that image asset is available.
{% endcomment %}
{%- liquid
  assign shop_url = routes.all_products_collection_url
  assign contact_url = routes.root_url | append: '#contact'
  assign row_birthday_eyebrow = 'occasions_page.rows.birthday.eyebrow' | t
  assign row_birthday_heading = 'occasions_page.rows.birthday.heading' | t
  assign row_anniversary_eyebrow = 'occasions_page.rows.anniversary.eyebrow' | t
  assign row_anniversary_heading = 'occasions_page.rows.anniversary.heading' | t
  assign row_graduation_eyebrow = 'occasions_page.rows.graduation.eyebrow' | t
  assign row_graduation_heading = 'occasions_page.rows.graduation.heading' | t
  assign row_sympathy_eyebrow = 'occasions_page.rows.sympathy.eyebrow' | t
  assign row_sympathy_heading = 'occasions_page.rows.sympathy.heading' | t
  assign row_get_well_eyebrow = 'occasions_page.rows.get_well.eyebrow' | t
  assign row_get_well_heading = 'occasions_page.rows.get_well.heading' | t
-%}

{% comment %} 1. Hero {% endcomment %}
<section class="bg-[#FAFAF2] py-[60px] lg:py-[90px]">
  <div class="mx-auto grid w-full max-w-[1440px] grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-[50px] lg:px-[70px]">
    <div class="relative">
      {% comment %} TODO: swap for the bride/bouquet hero photo once supplied {% endcomment %}
      <img
        src="{{ 'hero-2.png' | asset_url }}"
        alt="{{ 'occasions_page.hero_img_alt' | t }}"
        class="aspect-[4/5] w-full rounded-lg object-cover sm:aspect-square lg:aspect-[4/5]"
        width="1440"
        height="1440"
        loading="eager"
      >
    </div>

    <div class="max-w-[535px]">
      <p class="text-[13px] font-semibold uppercase tracking-[5.6px] text-[#525252] sm:text-[14px]">{{ 'occasions_page.hero_eyebrow' | t }}</p>
      <h1 class="mt-6 font-['Cormorant_Garamond'] text-4xl font-normal leading-[1.12] text-[#525252] sm:text-5xl lg:text-[52px]">{{ 'occasions_page.hero_heading' | t }}</h1>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href="{{ shop_url }}" class="flex h-9 items-center justify-center rounded-lg bg-[#899B7A] px-[18px] text-xs font-semibold uppercase tracking-[0.5px] text-white transition-colors duration-200 hover:bg-[#7a8c6b]">{{ 'occasions_page.shop_flowers' | t }}</a>
        <a href="{{ contact_url }}" class="flex h-9 items-center justify-center rounded-lg bg-[#BBCCBF] px-[18px] text-xs font-semibold uppercase tracking-[0.5px] text-white transition-colors duration-200 hover:bg-[#A8BCAE]">{{ 'occasions_page.custom_order' | t }}</a>
      </div>
    </div>
  </div>
</section>

{% comment %} 2. What Do You Want to Say? {% endcomment %}
<section class="bg-[#FAFAF2] pb-[60px] lg:pb-[90px]">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-[70px]">
    <div class="relative pb-8 text-center">
      <span class="absolute bottom-0 left-0 h-px w-full bg-[#CCC8A8]" aria-hidden="true"></span>
      <h2 class="relative inline-block bg-[#FAFAF2] px-6 font-['Crimson_Text'] text-3xl font-normal text-[#1E2934] lg:text-[32px]">{{ 'occasions_page.say_heading' | t }}</h2>
    </div>

    <div class="mt-2">
      {% render 'occasion-row', row_id: 'birthday', eyebrow: row_birthday_eyebrow, heading: row_birthday_heading, occasion: 'Birthday' %}
      {% render 'occasion-row', row_id: 'anniversary', eyebrow: row_anniversary_eyebrow, heading: row_anniversary_heading, occasion: 'Anniversary' %}
      {% render 'occasion-row', row_id: 'graduation', eyebrow: row_graduation_eyebrow, heading: row_graduation_heading, occasion: 'Graduation' %}
      {% render 'occasion-row', row_id: 'sympathy', eyebrow: row_sympathy_eyebrow, heading: row_sympathy_heading, occasion: 'Sympathy' %}
      {% render 'occasion-row', row_id: 'get-well-soon', eyebrow: row_get_well_eyebrow, heading: row_get_well_heading, occasion: 'Get Well Soon' %}
    </div>
  </div>
</section>

{% comment %} 3. Who Are You Sending Flowers To? {% endcomment %}
<section class="bg-[#FAFAF2] pb-[60px] lg:pb-[90px]">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-[70px]">
    <div class="relative pb-8 text-center">
      <span class="absolute bottom-0 left-0 h-px w-full bg-[#CCC8A8]" aria-hidden="true"></span>
      <h2 class="relative inline-block bg-[#FAFAF2] px-6 font-['Crimson_Text'] text-3xl font-normal text-[#1E2934] lg:text-[32px]">{{ 'occasions_page.recipients_heading' | t }}</h2>
    </div>

    <div class="mt-10 grid grid-cols-1 border-l border-t border-[#CCC8A8] sm:grid-cols-2 lg:grid-cols-3">
      {% comment %} Romantic partner {% endcomment %}
      <div class="flex flex-col items-start gap-3 border-b border-r border-[#CCC8A8] p-8">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-[#899B7A]"><path d="M12 20.5s-7.5-4.6-9.7-9C.9 8.2 2.3 4.8 5.5 4.4c2-.3 4 .7 5 2.4 0 0 1-1.8 3.2-2 2.2-.2 4 1.5 4.5 3.6.5 2.1-.9 4.4-2.2 6-2.4 2.9-4 6.1-4 6.1Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <h3 class="font-['Crimson_Text'] text-lg text-[#1E2934]">{{ 'occasions_page.recipient_partner_title' | t }}</h3>
        <p class="text-xs leading-relaxed text-[#6D6D6D]">{{ 'occasions_page.recipient_partner_text' | t }}</p>
        <p class="mt-1 text-[11px] italic leading-relaxed text-[#899B7A]">{{ 'occasions_page.recipient_partner_best' | t }}</p>
      </div>

      {% comment %} Parents {% endcomment %}
      <div class="flex flex-col items-start gap-3 border-b border-r border-[#CCC8A8] p-8">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-[#899B7A]"><circle cx="9" cy="7" r="3.2" stroke="currentColor" stroke-width="1.5" /><circle cx="17" cy="8.5" r="2.4" stroke="currentColor" stroke-width="1.5" /><path d="M3 20.5c0-3.5 2.7-6.2 6-6.2s6 2.7 6 6.2M14.8 20.5c-.2-2.6-1.4-4.7-3.2-5.9M15 12.4c2.6.1 4.7 2.2 4.9 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
        <h3 class="font-['Crimson_Text'] text-lg text-[#1E2934]">{{ 'occasions_page.recipient_parents_title' | t }}</h3>
        <p class="text-xs leading-relaxed text-[#6D6D6D]">{{ 'occasions_page.recipient_parents_text' | t }}</p>
        <p class="mt-1 text-[11px] italic leading-relaxed text-[#899B7A]">{{ 'occasions_page.recipient_parents_best' | t }}</p>
      </div>

      {% comment %} Friend {% endcomment %}
      <div class="flex flex-col items-start gap-3 border-b border-r border-[#CCC8A8] p-8">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-[#899B7A]"><circle cx="8.5" cy="8" r="3" stroke="currentColor" stroke-width="1.5" /><path d="M2.8 20c0-3.4 2.5-5.8 5.7-5.8s5.7 2.4 5.7 5.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><path d="M16 4.3c1.6.4 2.7 1.8 2.7 3.4 0 1.3-.7 2.5-1.8 3.1l.4 2.3-2-1.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <h3 class="font-['Crimson_Text'] text-lg text-[#1E2934]">{{ 'occasions_page.recipient_friend_title' | t }}</h3>
        <p class="text-xs leading-relaxed text-[#6D6D6D]">{{ 'occasions_page.recipient_friend_text' | t }}</p>
        <p class="mt-1 text-[11px] italic leading-relaxed text-[#899B7A]">{{ 'occasions_page.recipient_friend_best' | t }}</p>
      </div>

      {% comment %} Colleague / business {% endcomment %}
      <div class="flex flex-col items-start gap-3 border-b border-r border-[#CCC8A8] p-8">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-[#899B7A]"><rect x="3" y="8" width="18" height="11" rx="1.6" stroke="currentColor" stroke-width="1.5" /><path d="M8.5 8V6.2A1.7 1.7 0 0 1 10.2 4.5h3.6a1.7 1.7 0 0 1 1.7 1.7V8M3 13h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
        <h3 class="font-['Crimson_Text'] text-lg text-[#1E2934]">{{ 'occasions_page.recipient_colleague_title' | t }}</h3>
        <p class="text-xs leading-relaxed text-[#6D6D6D]">{{ 'occasions_page.recipient_colleague_text' | t }}</p>
        <p class="mt-1 text-[11px] italic leading-relaxed text-[#899B7A]">{{ 'occasions_page.recipient_colleague_best' | t }}</p>
      </div>

      {% comment %} Difficult time {% endcomment %}
      <div class="flex flex-col items-start gap-3 border-b border-r border-[#CCC8A8] p-8">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-[#899B7A]"><path d="M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H9l-4.5 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M8 9.5c0-1 .8-1.7 1.7-1.7.6 0 1 .3 1.3.7.3-.4.7-.7 1.3-.7.9 0 1.7.7 1.7 1.7 0 1.4-1.6 2.5-3 3.5-1.4-1-3-2.1-3-3.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
        <h3 class="font-['Crimson_Text'] text-lg text-[#1E2934]">{{ 'occasions_page.recipient_difficult_title' | t }}</h3>
        <p class="text-xs leading-relaxed text-[#6D6D6D]">{{ 'occasions_page.recipient_difficult_text' | t }}</p>
        <p class="mt-1 text-[11px] italic leading-relaxed text-[#899B7A]">{{ 'occasions_page.recipient_difficult_best' | t }}</p>
      </div>

      {% comment %} CTA cell {% endcomment %}
      <div class="flex flex-col items-start gap-3 border-b border-r border-[#CCC8A8] bg-[#FDF6F1] p-8">
        <h3 class="font-['Crimson_Text'] text-lg text-[#1E2934]">{{ 'occasions_page.cta_title' | t }}</h3>
        <p class="text-xs leading-relaxed text-[#6D6D6D]">{{ 'occasions_page.cta_text' | t }}</p>
        <a href="{{ contact_url }}" class="mt-2 flex h-9 items-center justify-center rounded-lg bg-[#899B7A] px-[18px] text-xs font-semibold uppercase tracking-[0.5px] text-white transition-colors duration-200 hover:bg-[#7a8c6b]">{{ 'occasions_page.cta_button' | t }}</a>
      </div>
    </div>
  </div>
</section>

<script>
  // Per-row pagination for "What Do You Want to Say?" — chunks each
  // occasion row's real product cards 3 at a time, reusing the same
  // numbered pagination look as the homepage Occasions teaser.
  (() => {
    const PAGE_SIZE = 3;

    document.querySelectorAll('[data-occasion-row]').forEach((row) => {
      const cards = Array.from(row.querySelectorAll('[data-row-card]'));
      const pagination = row.querySelector('[data-row-pagination]');
      const pages = Math.ceil(cards.length / PAGE_SIZE);
      if (!pagination || pages <= 1) return;

      let page = 1;

      const renderPagination = () => {
        pagination.classList.remove('hidden');
        pagination.classList.add('flex');
        pagination.innerHTML = `
          <button type="button" data-row-prev aria-label="${pagination.dataset.i18nPrev || 'Previous'}">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M7 2 3 6l4 4" stroke="#A2A2A2" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <div class="flex items-baseline gap-2 text-sm text-[#A2A2A2]">
            ${Array.from({ length: pages }, (_, i) => i + 1)
              .map((i) =>
                i === page
                  ? `<span class="relative font-bold text-[#525252]">${i}<span class="absolute -bottom-[6px] left-0 h-px w-[20px] bg-[#525252]"></span></span>`
                  : `<button type="button" data-row-page="${i}" class="cursor-pointer transition-colors hover:text-[#525252]">${i}</button>`
              )
              .join('')}
          </div>
          <button type="button" data-row-next aria-label="${pagination.dataset.i18nNext || 'Next'}">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m5 2 4 4-4 4" stroke="#A2A2A2" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        `;
        pagination.querySelector('[data-row-prev]')?.addEventListener('click', () => goTo(page - 1));
        pagination.querySelector('[data-row-next]')?.addEventListener('click', () => goTo(page + 1));
        pagination.querySelectorAll('[data-row-page]').forEach((btn) => {
          btn.addEventListener('click', () => goTo(Number(btn.dataset.rowPage)));
        });
      };

      const goTo = (n) => {
        page = Math.min(Math.max(n, 1), pages);
        cards.forEach((card, i) => {
          card.classList.toggle('hidden', Math.floor(i / PAGE_SIZE) + 1 !== page);
        });
        renderPagination();
      };

      goTo(1);
    });
  })();
</script>
