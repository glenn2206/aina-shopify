---
/**
 * Landing — Hero slider ANIA (responsive).
 */
import hero1 from '../assets/hero-1.png';
import hero2 from '../assets/hero-2.png';
import hero3 from '../assets/hero-3.png';

const slides = [
    {
        img: hero1,
        imgAlt: 'Buket bunga segar dalam kotak — ANIA Flower Boutique',
        eyebrow: 'For Those Unspoken Words',
        titleTop: 'Express your feelings beautifully...',
        titleBottom: '...through flowers',
        desc: 'ANIA Flower Boutique is a means of expressing emotions through flowers. In today’s fast-paced society, words are often lost when trying to express how we feel. For those unspoken words, the creations by the ANIA flower team offer a beautiful way to show care through the language of flowers.',
    },
    {
        img: hero2,
        imgAlt: 'Rangkaian bunga preserved — ANIA Flower Boutique',
        eyebrow: 'Timeless Beauty',
        titleTop: 'Preserve the moments',
        titleBottom: 'that matter the most',
        desc: 'Our preserved flower collection keeps your most precious memories alive for years. Each bloom is hand-selected and treated with care, so the beauty of your special day never fades away.',
    },
    {
        img: hero3,
        imgAlt: 'Buket bunga segar dalam kotak — ANIA Flower Boutique',
        eyebrow: 'For Those Unspoken Words',
        titleTop: 'Express your feelings beautifully...',
        titleBottom: '...through flowers',
        desc: 'ANIA Flower Boutique is a means of expressing emotions through flowers. In today’s fast-paced society, words are often lost when trying to express how we feel. For those unspoken words, the creations by the ANIA flower team offer a beautiful way to show care through the language of flowers.',
    },
];

const primaryCta = { label: 'VIEW COLLECTION', href: '/products' };
const secondaryCta = { label: 'View Catalogue', href: '/products' };
const total = slides.length;
---

<section
    data-hero
    class="relative w-full overflow-hidden bg-[#3B3A2F]"
    aria-roledescription="carousel"
    aria-label="Koleksi unggulan ANIA"
>
    <!-- Track slide: flex, setiap slide selebar viewport -->
    <div data-hero-track class="flex transition-transform duration-900 ease-[cubic-bezier(0.22,1,0.36,1)]">
        {slides.map((slide, i) => (
            <div
                data-hero-slide
                class={`relative w-full shrink-0 ${i === 0 ? 'is-active' : ''}`}
                role="group"
                aria-roledescription="slide"
                aria-label={`Slide ${i + 1} dari ${total}`}
            >
                <!-- Gambar background + ken-burns -->
                <div class="absolute inset-0 overflow-hidden">
                    <img
                        data-hero-img
                        class="h-full w-full object-cover object-center"
                        src={slide.img.src}
                        alt={slide.imgAlt}
                        loading={i === 0 ? 'eager' : 'lazy'}
                        fetchpriority={i === 0 ? 'high' : undefined}
                    />
                </div>

                <!-- Overlay gradasi gelap dari kiri agar teks terbaca -->
                <div class="absolute inset-0 bg-gradient-to-r from-[#2B2E2B]/85 via-[#2B2E2B]/45 to-transparent"></div>

                <!-- Konten -->
                <div
                    class="relative z-10 flex min-h-[calc(100svh)] flex-col justify-center px-5 py-28 sm:px-8 sm:py-32 lg:min-h-[calc(100svh)] lg:px-[70px] lg:py-24"
                >
                    <div data-hero-content class="flex max-w-[621px] flex-col items-start gap-4">
                        <p
                            data-anim
                            style="--d: 720ms"
                            class="text-[10px] font-semibold uppercase tracking-[4px] text-[#CCC8A8]"
                        >
                            {slide.eyebrow}
                        </p>

                        <h1 class="flex flex-col gap-5 sm:gap-6">
                            <span
                                data-anim
                                style="--d: 840ms"
                                class="font-['Cormorant_Garamond'] text-4xl font-normal leading-[1.15] text-[#BCC6BC] sm:text-5xl lg:text-7xl lg:leading-[87px]"
                            >
                                {slide.titleTop}
                            </span>
                            <span
                                data-anim
                                style="--d: 960ms"
                                class="font-['Cormorant_Garamond'] text-4xl font-semibold italic leading-[1.15] text-[#CCC8A8] sm:text-5xl lg:text-7xl lg:leading-[87px]"
                            >
                                {slide.titleBottom}
                            </span>
                        </h1>

                        <p data-anim style="--d: 1080ms" class="mt-1 max-w-[520px] text-sm font-normal leading-6 text-[#CCC8A8]/90 sm:text-xs">
                            {slide.desc}
                        </p>

                        <div
                            data-anim
                            style="--d: 1200ms"
                            class="mt-2 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center sm:gap-6"
                        >
                            <a
                                href={primaryCta.href}
                                class="flex h-9 w-full items-center justify-center rounded-lg bg-[#CCC8A8] text-xs font-semibold text-black transition-colors duration-200 hover:bg-[#E8E3C8] sm:w-[150px]"
                            >
                                {primaryCta.label}
                            </a>
                            <a
                                href={secondaryCta.href}
                                class="flex h-9 w-full items-center justify-center rounded-lg border border-[#CCC8A8]/70 text-xs font-normal uppercase text-[#CCC8A8] transition-colors duration-200 hover:bg-[#CCC8A8]/10 sm:w-[150px]"
                            >
                                {secondaryCta.label}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        ))}
    </div>

    <!-- Indikator / progress slide (Di Tengah Bawah) -->
    <div
        class="absolute bottom-6 left-1/2 z-20 flex -translate-x-1/2 items-center gap-2 sm:gap-3 lg:bottom-[48px]"
    >
        {slides.map((_, i) => (
            <button
                type="button"
                data-progress
                data-progress-index={i}
                class="h-0.5 w-12 cursor-pointer overflow-hidden rounded-full bg-white/25 transition-colors duration-300 hover:bg-white/40 sm:w-20 lg:w-32"
                aria-label={`Ke slide ${i + 1}`}
            >
                <span data-progress-fill class="block h-full w-0 bg-[#FCF6F3]"></span>
            </button>
        ))}
    </div>

    <!-- Panah prev / next (Vertikal di Tengah Kiri & Kanan) -->
    <button
        type="button"
        data-hero-prev
        class="absolute left-4 top-1/2 z-20 flex size-9 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-[#CCC8A8]/40 text-[#CCC8A8] transition-colors duration-200 hover:bg-[#CCC8A8] hover:text-[#3B3A2F] sm:left-6 sm:size-10 lg:left-8"
        aria-label="Slide sebelumnya"
    >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>
    <button
        type="button"
        data-hero-next
        class="absolute right-4 top-1/2 z-20 flex size-9 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-[#CCC8A8]/40 text-[#CCC8A8] transition-colors duration-200 hover:bg-[#CCC8A8] hover:text-[#3B3A2F] sm:right-6 sm:size-10 lg:right-8"
        aria-label="Slide berikutnya"
    >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>
</section>

<style>
    /* Ken-burns: gambar slide aktif di-zoom halus selama satu interval autoplay */
    [data-hero-img] {
        transition: transform 5000ms linear;
        transform: scale(1);
    }
    [data-hero-slide].is-active [data-hero-img] {
        transform: scale(1.08);
    }

    /* Konten slide: tersembunyi dulu, lalu naik bertahap saat slide aktif */
    [data-hero-content] > * {
        opacity: 0;
        transform: translateX(-56px) translateY(20px);
    }
    [data-hero-slide].is-active [data-hero-content] > * {
        animation: hero-rise 700ms cubic-bezier(0.22, 1, 0.36, 1) var(--d, 720ms) forwards;
    }

    @keyframes hero-rise {
        from {
            opacity: 0;
            transform: translateX(-56px) translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateX(0) translateY(0);
        }
    }
</style>

<script>
    (() => {
        const section = document.querySelector('[data-hero]');
        if (!section) return;
        const track = section.querySelector('[data-hero-track]');
        const slides = [...section.querySelectorAll('[data-hero-slide]')];
        const progressBars = [...section.querySelectorAll('[data-progress]')];
        const fills = progressBars.map((bar) => bar.querySelector('[data-progress-fill]'));
        const prevBtn = section.querySelector('[data-hero-prev]');
        const nextBtn = section.querySelector('[data-hero-next]');

        if (!track || slides.length < 2) return;

        const DURATION = 5000;

        let current = 0;
        let timer = null;
        let paused = false;

        const clearTimer = () => {
            if (timer) {
                clearTimeout(timer);
                timer = null;
            }
        };

        const schedule = () => {
            clearTimer();
            if (paused) return;
            // 💡 Panggil nextSlide untuk mengecek apakah sudah di slide terakhir
            timer = setTimeout(() => nextSlide(), DURATION);
        };

        const setProgress = (idx) => {
            fills.forEach((fill, i) => {
                fill.style.transition = 'none';
                fill.style.width = i < idx ? '100%' : '0%';
            });
            const fill = fills[idx];
            if (!fill) return;
            void fill.offsetWidth; // force reflow
            fill.style.transition = `width ${DURATION}ms linear`;
            fill.style.width = '100%';
        };

        const goTo = (idx) => {
            current = idx;

            slides.forEach((s, i) => s.classList.toggle('is-active', i === current));

            track.style.transform = `translateX(-${current * 100}%)`;

            setProgress(current);
            schedule();
        };

        // 💡 Fungsi baru untuk menangani perpindahan ke slide berikutnya + auto-scroll saat di slide terakhir
        const nextSlide = () => {
            if (current === slides.length - 1) {
                // Jika sudah di slide terakhir, hentikan timer & scroll 100vh ke bawah
                clearTimer();
                window.scrollBy({
                    top: window.innerHeight, // Scroll 100vh
                    behavior: 'smooth'       // Efek scroll halus
                });
            } else {
                goTo(current + 1);
            }
        };

        const setPaused = (value) => {
            paused = value;
            if (paused) {
                clearTimer();
            } else {
                setProgress(current);
                schedule();
            }
        };

        // Mulai autoplay
        setProgress(0);
        schedule();

        // Kontrol manual
        nextBtn?.addEventListener('click', () => nextSlide());
        prevBtn?.addEventListener('click', () => goTo((current - 1 + slides.length) % slides.length));
        progressBars.forEach((bar, i) => bar.addEventListener('click', () => goTo(i)));

        // Pause saat tab tidak terlihat
        document.addEventListener('visibilitychange', () => setPaused(document.hidden));

        // Swipe (touch / pointer)
        let startX = null;
        section.addEventListener('pointerdown', (e) => {
            startX = e.clientX;
        });
        section.addEventListener('pointerup', (e) => {
            if (startX === null) return;
            const dx = e.clientX - startX;
            startX = null;
            if (Math.abs(dx) < 50) return;
            if (dx < 0) nextSlide();
            else goTo((current - 1 + slides.length) % slides.length);
        });
    })();
</script>