---
/**
 * ModernApproach — Section "A Modern Approach" (About Us node 137:4310).
 *
 * Frame 1321317534 @(0,682) 1440x506:
 *   - Gambar kiri 960x506 (pexels-cottonbro-4270221)
 *   - Judul "A Modern Approach" Crimson Text 32 #1E2934
 *   - Paragraf Open Sans 14 #3D3B2F (lebar ~380)
 */
import { Image } from 'astro:assets';
import modernImg from '../../assets/figma/about-modern.png';

const paragraph =
	'Lorem ipsum dolor sit amet consectetur. Mi et at imperdiet in pellentesque vel id nunc ut. Turpis lorem augue vulputate aliquam eget fames vehicula dolor. Sed ultrices id vehicula nunc amet dignissim massa non. Tristique in. Lorem ipsum dolor sit amet consectetur. Mi et at imperdiet in pellentesque vel id nunc ut. Turpis lorem augue vulputate aliquam eget fames vehicula dolor. Sed ultrices id vehicula nunc amet dignissim massa non. Tristique in.';
---

<section class="w-full overflow-hidden bg-[#FDF6F1]">
	<div class="grid w-full max-w-[1440px] grid-cols-1 items-stretch lg:grid-cols-[960px_480px]">
		<!-- Gambar -->
		<div class="relative order-2 h-[320px] lg:order-1 lg:h-auto">
			<Image
				src={modernImg}
				alt="Proses modern ANIA Flower Boutique"
				class="absolute inset-0 h-full w-full object-cover"
				width={960}
				height={506}
				loading="lazy"
			/>
		</div>

		<!-- Teks -->
		<div class="order-1 flex flex-col justify-center px-5 py-16 sm:px-10 lg:order-2 lg:px-[40px] lg:py-0 lg:pl-14">
			<h2 class="font-['Crimson_Text'] text-3xl font-normal text-[#1E2934] lg:text-[32px]">A Modern Approach</h2>
			<p class="mt-5 max-w-[380px] text-sm font-normal leading-[1.65] text-[#3D3B2F]">{paragraph}</p>
		</div>
	</div>
</section>
