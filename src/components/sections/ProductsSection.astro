---
/**
 * ProductsSection — Halaman Product ("Products Page Desktop" node 137:1467).
 *
 *   - Heading "Premium Wrapped Bloom" Crimson Text 32 (rata tengah)
 *   - Sidebar filter fungsional: All Products, Sale, Category ▾,
 *     For Occassions ▾, Flowers ▾ (client-side, lihat <script>)
 *   - "Default sorting" dropdown + toggle grid di kanan atas
 *   - Grid produk 3×3 (ProductCard → link ke /details/{slug})
 *   - Pagination 9/halaman + tombol WhatsApp melayang
 */
import ProductCard from './ProductCard.astro';
import { products as catalog, formatPrice, categoryFilterGroups, occasionOptions, flowerOptions } from '../../data/products';

/** Produk siap-render: harga diformat + slug + tag untuk filter client-side. */
const products = catalog.map((p) => ({
	image: p.image,
	alt: p.title,
	category: p.category,
	title: p.title,
	price: formatPrice(p.price),
	priceOld: p.priceOld ? formatPrice(p.priceOld) : undefined,
	badge: p.badge,
	standardThumb: p.standardThumb,
	premiumThumb: p.premiumThumb,
	slug: p.slug,
	occasions: p.occasions.join(' '),
	flowers: p.flowers.join(' '),
	priceNumber: p.price,
}));
---

<section class="bg-[#FDF6F1]">
	<div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-[50px]">
		<!-- Heading + sort -->
		<div class="relative pt-10">
			<h1 class="text-center font-['Crimson_Text'] text-3xl font-normal text-[#1E2934] lg:text-[32px]">
				Premium Wrapped Bloom
			</h1>

			<div class="mt-6 flex items-center justify-between gap-4 lg:absolute lg:right-0 lg:top-10 lg:mt-0">
				<!-- Filter (mobile) -->
				<button
					data-filter-toggle
					type="button"
					class="flex h-[29px] cursor-pointer items-center gap-2 rounded-full border border-[#EAE8E8] bg-transparent px-4 text-xs font-normal text-black lg:hidden"
				>
					Filter
					<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
						<path d="M2 3h8M4 6h4M5.5 9h1" stroke="#3D3B2F" stroke-width="1.2" stroke-linecap="round" />
					</svg>
				</button>

				<!-- Sorting dropdown -->
				<div class="relative">
					<button
						data-sort-toggle
						type="button"
						class="flex h-[29px] cursor-pointer items-center gap-2 rounded-full border border-[#EAE8E8] bg-transparent px-4 text-xs font-normal text-black"
					>
						<span data-sort-label>Default sorting</span>
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
							<path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#3D3B2F" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
					<div
						data-sort-menu
						class="absolute right-0 top-full z-20 mt-2 hidden w-56 rounded-lg border border-[#EAE8E8] bg-white p-1.5 shadow-[0_8px_24px_rgba(61,59,47,0.12)]"
					>
						<button data-sort="default" type="button" class="block w-full cursor-pointer rounded-md px-3 py-2 text-left text-xs text-[#3D3B2F] hover:bg-[#FDF6F1]">Default sorting</button>
						<button data-sort="price-asc" type="button" class="block w-full cursor-pointer rounded-md px-3 py-2 text-left text-xs text-[#3D3B2F] hover:bg-[#FDF6F1]">Price: Low to High</button>
						<button data-sort="price-desc" type="button" class="block w-full cursor-pointer rounded-md px-3 py-2 text-left text-xs text-[#3D3B2F] hover:bg-[#FDF6F1]">Price: High to Low</button>
						<button data-sort="name" type="button" class="block w-full cursor-pointer rounded-md px-3 py-2 text-left text-xs text-[#3D3B2F] hover:bg-[#FDF6F1]">Name: A to Z</button>
					</div>
				</div>

				<button
					type="button"
					aria-label="Tampilan grid"
					class="flex h-6 w-6 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-[#3D3B2F]"
				>
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor" />
						<rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor" />
						<rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor" />
						<rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor" />
					</svg>
				</button>
			</div>
		</div>

		<!-- Sidebar + grid -->
		<div class="mt-8 flex flex-col gap-8 lg:mt-12 lg:flex-row lg:gap-5">
			<!-- Sidebar filter -->
			<aside data-filter-panel class="hidden w-full shrink-0 flex-col lg:flex lg:w-[320px]">
				<button
					data-filter-all
					type="button"
					class="is-filter-active flex items-center gap-2 border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]"
				>
					All Products
				</button>
				<span class="mt-3 h-px w-full bg-[#CCC8A8]"></span>

				<button
					data-filter-sale
					type="button"
					class="mt-3 flex items-center gap-2 border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]"
				>
					Sale
				</button>
				<span class="mt-3 h-px w-full bg-[#CCC8A8]"></span>

				<div class="mt-3">
					<button type="button" class="flex w-full items-center justify-between border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]">
						Category
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
							<path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#D0D0D0" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
					<ul class="mt-2 flex flex-col">
						{categoryFilterGroups.map((g) => (
							<li>
								<button
									data-filter-category
									data-filter-category={g.key}
									type="button"
									class="flex w-full items-center gap-2 px-2 py-[3px] text-left text-base tracking-[-0.8px] text-[#6D6D6D]"
								>
									<span class="text-[#3D3B2F]">•</span>
									<span class="py-[3px]">{g.label}</span>
								</button>
							</li>
						))}
					</ul>
				</div>
				<span class="mt-2 h-px w-full bg-[#CCC8A8]"></span>

				<div class="mt-3">
					<button type="button" class="flex w-full items-center justify-between border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]">
						For Occassions
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
							<path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#D0D0D0" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
					<ul class="mt-2 flex flex-col">
						{occasionOptions.map((o) => (
							<li>
								<button
									data-filter-occasion
									data-filter-occasion={o}
									type="button"
									class="flex w-full items-center gap-2 px-2 py-[3px] text-left text-base tracking-[-0.8px] text-[#6D6D6D]"
								>
									<span class="text-[#7E4C4C]">•</span>
									<span class="py-[3px]">{o}</span>
								</button>
							</li>
						))}
					</ul>
				</div>
				<span class="mt-2 h-px w-full bg-[#CCC8A8]"></span>

				<div class="mt-3">
					<button type="button" class="flex w-full items-center justify-between border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]">
						Flowers
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
							<path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#D0D0D0" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
					<ul class="mt-2 flex flex-col">
						{flowerOptions.map((f) => (
							<li>
								<button
									data-filter-flower
									data-filter-flower={f}
									type="button"
									class="flex w-full items-center gap-2 px-2 py-[3px] text-left text-base tracking-[-0.8px] text-[#6D6D6D]"
								>
									<span class="text-[#7E4C4C]">•</span>
									<span class="py-[3px]">{f}</span>
								</button>
							</li>
						))}
					</ul>
				</div>
			</aside>

			<!-- Grid produk -->
			<div class="flex-1">
				<div data-product-grid class="grid grid-cols-1 gap-x-5 gap-y-12 sm:grid-cols-2 xl:grid-cols-3">
					{products.map((p) => (
						<div
							data-product-card
							data-category={p.category}
							data-occasions={p.occasions}
							data-flowers={p.flowers}
							data-sale={String(p.badge === 'Sale')}
							data-price={p.priceNumber}
							data-title={p.title}
						>
							<ProductCard {...p} />
						</div>
					))}
				</div>

				<p data-result-count class="mt-10 text-center text-xs tracking-wide text-[#6D6D6D]"></p>

				<!-- Pagination (diisi oleh JS) -->
				<div data-pagination class="relative mt-10 pb-8"></div>
			</div>
		</div>


		<!-- WhatsApp float -->
		<a
			href="https://wa.me/"
			target="_blank"
			rel="noopener"
			aria-label="Chat WhatsApp"
			class="fixed bottom-6 right-6 z-40 flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-[0_8px_24px_rgba(0,0,0,0.18)] transition-transform duration-200 hover:scale-105"
		>
			<svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.8-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"
					fill="#22CE5A"
				/>
			</svg>
		</a>
	</div>
</section>

<style>
	[data-filter-all].is-filter-active,
	[data-filter-sale].is-filter-active {
		color: #3d3b2f;
		font-weight: 600;
	}
	[data-filter-category].is-filter-active,
	[data-filter-occasion].is-filter-active,
	[data-filter-flower].is-filter-active {
		background: #bbccbf;
		color: #525252;
		font-weight: 600;
	}
</style>


<script>
	const cards = Array.from(document.querySelectorAll('[data-product-card]'));
	const grid = document.querySelector('[data-product-grid]');
	const pagination = document.querySelector('[data-pagination]');
	const resultCount = document.querySelector('[data-result-count]');
	const sortToggle = document.querySelector('[data-sort-toggle]');
	const sortMenu = document.querySelector('[data-sort-menu]');
	const sortLabel = document.querySelector('[data-sort-label]');

	const PAGE_SIZE = 9;
	const state = { category: null, occasion: null, flower: null, sale: false, sort: 'default', page: 1 };

	const matches = (card) => {
		if (state.sale && card.dataset.sale !== 'true') return false;
		if (state.category && card.dataset.category !== state.category) return false;
		if (state.occasion && !(card.dataset.occasions || '').split(' ').includes(state.occasion)) return false;
		if (state.flower && !(card.dataset.flowers || '').split(' ').includes(state.flower)) return false;
		return true;
	};

	const sorted = (list) => {
		const arr = [...list];
		if (state.sort === 'price-asc') arr.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
		else if (state.sort === 'price-desc') arr.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
		else if (state.sort === 'name') arr.sort((a, b) => (a.dataset.title || '').localeCompare(b.dataset.title || ''));
		return arr;
	};

	const refreshFilterUI = () => {
		document.querySelectorAll('[data-filter-all]').forEach((el) =>
			el.classList.toggle('is-filter-active', !state.sale && !state.category && !state.occasion && !state.flower)
		);
		document.querySelectorAll('[data-filter-sale]').forEach((el) => el.classList.toggle('is-filter-active', state.sale));
		document.querySelectorAll('[data-filter-category]').forEach((el) =>
			el.classList.toggle('is-filter-active', el.dataset.filterCategory === state.category)
		);
		document.querySelectorAll('[data-filter-occasion]').forEach((el) =>
			el.classList.toggle('is-filter-active', el.dataset.filterOccasion === state.occasion)
		);
		document.querySelectorAll('[data-filter-flower]').forEach((el) =>
			el.classList.toggle('is-filter-active', el.dataset.filterFlower === state.flower)
		);
	};

	const render = () => {
		const filtered = cards.filter(matches);
		const list = sorted(filtered);
		const pages = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
		if (state.page > pages) state.page = pages;
		const start = (state.page - 1) * PAGE_SIZE;
		const slice = list.slice(start, start + PAGE_SIZE);

		cards.forEach((c) => c.classList.toggle('hidden', !slice.includes(c)));
		refreshFilterUI();

		if (resultCount) resultCount.textContent = `Showing ${list.length} of ${cards.length} products`;

		if (!pagination) return;
		if (pages <= 1) {
			pagination.innerHTML = '';
			return;
		}
		let html = '<div class="flex items-center justify-center gap-5 text-[10px] font-normal text-[#6D6D6D]/50">';
		for (let i = 1; i <= pages; i++) {
			if (i === state.page) {
				html += `<span class="relative font-bold text-[#3D3B2F]">${i}<span class="absolute -bottom-1 left-1/2 h-[2px] w-5 -translate-x-1/2 bg-[#3D3B2F]"></span></span>`;
			} else {
				html += `<button type="button" data-page="${i}" class="cursor-pointer transition-colors hover:text-[#3D3B2F]">${i}</button>`;
			}
		}
		html += '</div><span class="absolute -bottom-0.5 left-0 h-px w-full bg-[#CCC8A8]"></span>';
		pagination.innerHTML = html;
	};

	// All Products → reset semua filter
	document.querySelector('[data-filter-all]')?.addEventListener('click', () => {
		state.category = null;
		state.occasion = null;
		state.flower = null;
		state.sale = false;
		state.page = 1;
		render();
	});

	// Sale → toggle
	document.querySelector('[data-filter-sale]')?.addEventListener('click', () => {
		state.sale = !state.sale;
		state.page = 1;
		render();
	});

	// Category / Occasion / Flower → toggle single select
	[
		{ selector: '[data-filter-category]', key: 'category', attr: 'filterCategory' },
		{ selector: '[data-filter-occasion]', key: 'occasion', attr: 'filterOccasion' },
		{ selector: '[data-filter-flower]', key: 'flower', attr: 'filterFlower' },
	].forEach(({ selector, key, attr }) => {
		document.querySelectorAll(selector).forEach((btn) => {
			btn.addEventListener('click', () => {
				const value = btn.dataset[attr];
				state[key] = state[key] === value ? null : value;
				state.page = 1;
				render();
			});
		});
	});

	// Pagination (delegasi — konten di-generate ulang)
	pagination?.addEventListener('click', (e) => {
		const btn = e.target.closest('[data-page]');
		if (!btn) return;
		state.page = Number(btn.dataset.page);
		render();
	});

	// Sorting
	sortToggle?.addEventListener('click', () => sortMenu?.classList.toggle('hidden'));
	document.querySelectorAll('[data-sort]').forEach((btn) => {
		btn.addEventListener('click', () => {
			state.sort = btn.dataset.sort;
			state.page = 1;
			if (sortLabel) sortLabel.textContent = btn.textContent.trim();
			sortMenu?.classList.add('hidden');
			render();
		});
	});
	document.addEventListener('click', (e) => {
		if (sortMenu && !e.target.closest('[data-sort-toggle]') && !e.target.closest('[data-sort-menu]')) {
			sortMenu.classList.add('hidden');
		}
	});

	// Filter panel mobile
	document.querySelector('[data-filter-toggle]')?.addEventListener('click', () => {
		const panel = document.querySelector('[data-filter-panel]');
		panel?.classList.toggle('hidden');
	});

	render();
</script>

